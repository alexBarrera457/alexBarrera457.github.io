---
interface Props {
  className?: string;
}

const { className = '' } = Astro.props;
---

<div class={`language-switcher ${className}`.trim()} aria-label="Idioma">
  <button type="button" class="lang-btn" data-language="es" aria-pressed="true">ES</button>
  <button type="button" class="lang-btn" data-language="ca" aria-pressed="false">CA</button>
  <button type="button" class="lang-btn" data-language="en" aria-pressed="false">EN</button>
</div>
