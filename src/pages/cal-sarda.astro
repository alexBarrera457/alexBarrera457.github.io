      const probItems = document.querySelectorAll('[data-status-problem-list] li');
      probItems.forEach((li, idx) => { if (d.sProblemList[idx]) li.textContent = d.sProblemList[idx]; });
      const solItems = document.querySelectorAll('[data-status-solution-list] li');
      solItems.forEach((li, idx) => { if (d.sSolutionList[idx]) li.textContent = d.sSolutionList[idx]; });

      const s2T = document.querySelector('[data-section-2-title]');
      if (s2T) s2T.textContent = d.s2Title;
      const s2I = document.querySelector('[data-section-2-intro]');
      if (s2I) s2I.textContent = d.s2Intro;

      document.querySelectorAll('.arch-cards-grid .arch-card').forEach((card, idx) => {
        const item = d.archCards[idx];
        if (item) {
          const h4 = card.querySelector('h4');
          if (h4) h4.textContent = item.title;
          card.querySelectorAll('li').forEach((li, lIdx) => {
            if (item.items[lIdx]) li.innerHTML = item.items[lIdx];
          });
        }
      });

