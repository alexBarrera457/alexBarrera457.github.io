      if (gS) gS.textContent = d.gallerySubtitle;

      document.querySelectorAll('.views-grid .view-card').forEach((card, idx) => {
        const item = d.galleryCards[idx];
        if (item) {
          const badge = card.querySelector('.view-badge');
          if (badge) badge.textContent = item.badge;
          const title = card.querySelector('h4');
          if (title) title.textContent = item.title;
          const desc = card.querySelector('p');
          if (desc) desc.textContent = item.desc;
        }
      });

      const m1L = document.querySelector('[data-metric-1-label]');
      if (m1L) m1L.textContent = d.metric1Label;
      const m1D = document.querySelector('[data-metric-1-desc]');
      if (m1D) m1D.textContent = d.metric1Desc;
      const m2L = document.querySelector('[data-metric-2-label]');
      if (m2L) m2L.textContent = d.metric2Label;
      const m2D = document.querySelector('[data-metric-2-desc]');
      if (m2D) m2D.textContent = d.metric2Desc;
      const m3L = document.querySelector('[data-metric-3-label]');
      if (m3L) m3L.textContent = d.metric3Label;
      const m3D = document.querySelector('[data-metric-3-desc]');
      if (m3D) m3D.textContent = d.metric3Desc;
