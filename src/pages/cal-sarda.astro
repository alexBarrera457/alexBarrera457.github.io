      const ctaBtn = document.querySelector('[data-cta-btn]');
      if (ctaBtn) ctaBtn.textContent = d.ctaBtn;
      const footBack = document.querySelector('[data-footer-back]');
      if (footBack) footBack.textContent = d.footerBack;

      document.title = d.docTitle;
      document.querySelector('meta[name="description"]')?.setAttribute('content', d.docDesc);
      document.documentElement.lang = lang;
      localStorage.setItem('portfolio-language', lang);
    };

    const detectLang = (): 'es' | 'ca' | 'en' => {
      const stored = localStorage.getItem('portfolio-language');
      if (stored === 'ca' || stored === 'en' || stored === 'es') return stored;
      const nav = (typeof navigator !== 'undefined' ? (navigator.language || (navigator as any).userLanguage || '') : '').toLowerCase();
      if (nav.startsWith('ca')) return 'ca';
      if (nav.startsWith('en')) return 'en';
      return 'es';
    };
    const initLang = detectLang();
    calsardaButtons.forEach((b) => b.addEventListener('click', () => calsardaSetLanguage((b.dataset.language || 'es') as 'es' | 'ca' | 'en')));
    calsardaSetLanguage(initLang);
