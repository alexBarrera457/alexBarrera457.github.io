---
import BaseLayout from '../layouts/BaseLayout.astro';
import LanguageSwitcher from '../components/LanguageSwitcher.astro';

const stack = ['Angular 22', 'TypeScript', 'SSR / Express', 'Monorepo', 'Signals', 'Domain-Driven', 'Responsive'];

const appViews = [
  {
    id: 'tienda',
    title: 'Tienda Online & Catálogo',
    badge: 'Catálogo Frontend',
    desc: 'Catálogo con más de 450 referencias organizadas por familias: conservas de mar, cafés de autor, frutos secos, dulces y bodega gourmet.',
    img: '/images/calsarda-tienda.jpg'
  },
  {
    id: 'lotes',
    title: 'Lotes y Cestas Gourmet',
    badge: 'Regalos & Empresas',
    desc: 'Módulo de configuración y pedido de lotes gastronómicos personalizados para particulares y empresas.',
    img: '/images/calsarda-lotes.jpg'
  },
  {
    id: 'historia',
    title: 'Nuestra Historia (Desde 1930)',
    badge: 'Patrimonio & Marca',
    desc: 'Sección editorial que recorre cuatro generaciones de comercio tradicional en Barcelona, desde la lechería de 1930 hasta hoy.',
    img: '/images/calsarda-historia.jpg'
  },
  {
    id: 'galeria',
    title: 'Galería de la Tienda Física',
    badge: 'Comercio de Proximidad',
    desc: 'Recorrido visual por el establecimiento de la calle Marina en el barrio de la Sagrada Família.',
    img: '/images/calsarda-galeria.jpg'
  }
];
---

<BaseLayout
  title="Cal Sardà · Aplicación Web E-Commerce Real"
  description="Cal Sardà — Plataforma web e-commerce para el comercio gastronómico centenario fundado en 1930. Desarrollado con Angular 22, SSR y Monorepo."
  ogImage="https://alexbarrera457.github.io/images/calsarda-tienda.jpg"
  canonicalUrl="https://alexbarrera457.github.io/cal-sarda"
  bodyClass="project-page"
>
  <header class="project-header">
    <div class="container project-header-inner">
      <div class="header-nav-bar">
        <a class="back-link" href="/">← Volver al portfolio</a>
        <LanguageSwitcher />
      </div>

      <div class="header-hero">
        <span class="eyebrow project-eyebrow">Proyecto personal · Aplicación real · 2026</span>
        <h1 class="project-title">Cal Sardà</h1>
        <p class="lead">
          Plataforma web de comercio electrónico desarrollada con <strong>Angular 22</strong> y <strong>Server-Side Rendering (SSR)</strong>
          para digitalizar el emblemático comercio tradicional centenario <strong>Cal Sardà</strong> (fundado en 1930 en Barcelona):
          catálogo con más de 450 referencias gastronómicas, gestión de lotes gourmet y pedidos Click & Collect.
        </p>
        <div class="stack-list">
          {stack.map((item) => <span class="stack-pill">{item}</span>)}
        </div>
        <div class="header-actions">
          <a class="button primary" href="https://github.com/alexBarrera457/Prototipo-Cal-Sard-" target="_blank" rel="noopener noreferrer" data-header-repo-btn>
            Ver repositorio en GitHub ↗
          </a>
          <a class="button" href="#capturas-reales" data-header-gallery-btn>
            Explorar capturas reales ↓
          </a>
        </div>
      </div>
    </div>
  </header>

  <!-- Real Web Application Hero Showcase -->
  <div class="container cover-wrap" id="capturas-reales">
    <div class="browser-showcase">
      <div class="browser-bar">
        <div class="browser-controls">
          <span class="dot close"></span>
          <span class="dot min"></span>
          <span class="dot max"></span>
        </div>
        <div class="browser-url">
          <span class="url-lock">🔒</span>
          <span class="url-text">https://calsarda.cat/tienda-online</span>
          <span class="url-badge">Angular 22 · SSR Activo</span>
        </div>
        <div class="browser-actions">
          <span class="live-dot"></span>
          <span class="live-text">Captura real de la app</span>
        </div>
      </div>
      <div class="browser-screen">
        <img
          id="main-showcase-img"
          src="/images/calsarda-tienda.jpg"
          alt="Captura real de la tienda online Cal Sardà en Angular 22"
          class="showcase-img"
          width="1440"
          height="900"
          fetchpriority="high"
          decoding="async"
        />
        <div class="showcase-floating-badge">
          <span class="floating-icon">🛒</span>
          <div>
            <strong>Tienda Online Operativa</strong>
            <span>450+ productos gastronómicos catalogados</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <main class="container project-content">
    <!-- Real Views Tabs & Gallery Section -->
    <section class="project-panel gallery-panel">
      <div class="panel-header-row">
        <div>
          <h2 data-gallery-title>Capturas reales de la aplicación</h2>
          <p data-gallery-subtitle>
            Vistas reales del prototipo web compilado y renderizado en servidor (SSR), reflejando la identidad visual y funcional del negocio:
          </p>
        </div>
      </div>

      <div class="views-grid">
        {appViews.map((view) => (
          <article class="view-card" data-view-id={view.id}>
            <div class="view-image-wrap">
              <span class="view-badge">{view.badge}</span>
              <img src={view.img} alt={view.title} loading="lazy" decoding="async" width="800" height="500" />
            </div>
            <div class="view-info">
              <h4>{view.title}</h4>
              <p>{view.desc}</p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- Key Impact Metrics -->
    <section class="metrics-grid">
      <div class="metric-card">
        <span class="metric-num">450+</span>
        <span class="metric-label" data-metric-1-label>Productos catalogados</span>
        <p class="metric-desc" data-metric-1-desc>Familias completas: cafés artesanos, conservas de mar, ibéricos y dulces.</p>
      </div>
      <div class="metric-card">
        <span class="metric-num">Angular 22</span>
        <span class="metric-label" data-metric-2-label>Monorepo Modular</span>
        <p class="metric-desc" data-metric-2-desc>Arquitectura con paquete compartido de dominio (@cal-sarda/domain) y SSR.</p>
      </div>
      <div class="metric-card">
        <span class="metric-num">1930</span>
        <span class="metric-label" data-metric-3-label>Historia y Comercio</span>
        <p class="metric-desc" data-metric-3-desc>Establecimiento centenario en la calle Marina (Sagrada Família, Barcelona).</p>
      </div>
      <div class="metric-card">
        <span class="metric-num">0 min</span>
        <span class="metric-label" data-metric-4-label>Click & Collect</span>
        <p class="metric-desc" data-metric-4-desc>Flujo de encargo web con recogida ágil en tienda sin hacer colas.</p>
      </div>
    </section>

    <!-- Business Context & Motivation -->
    <section class="project-panel">
      <h2 data-section-1-title>Contexto real: del mostrador al software</h2>
      <p data-section-1-intro>
        Cal Sardà es un establecimiento emblemático con casi un siglo de historia en Barcelona, ubicado en la calle Marina.
        Durante 2024 trabajé allí directamente como dependiente de tienda. Esa experiencia diaria me permitió entender los problemas
        reales del comercio de proximidad y transformarlos en especificaciones técnicas de software:
      </p>
      <div class="status-grid">
        <div class="status-box">
          <h3 data-status-problem-title>🏪 Retos en la tienda física</h3>
          <ul class="bullet-list" data-status-problem-list>
            <li>Gestión de encargos apuntados en libretas de papel en plena hora punta.</li>
            <li>Colas de espera evitables para clientes que únicamente venían a recoger un encargo.</li>
            <li>Consultas repetitivas sobre ingredientes, alérgenos y formatos de regalo.</li>
            <li>Falta de canal digital para consultar catálogo y stock fuera de horario comercial.</li>
          </ul>
        </div>
        <div class="status-box success">
          <h3 data-status-solution-title>💡 Soluciones implementadas en la web</h3>
          <ul class="bullet-list" data-status-solution-list>
            <li>Catálogo digital 24/7 con fotos reales tomadas en la tienda y fichas detalladas.</li>
            <li>Configurador de lotes y cestas gourmet con presupuesto cerrado para regalo.</li>
            <li>Sistema Click & Collect para preparar pedidos antes de la llegada del cliente.</li>
            <li>Página editorial que pone en valor los más de 90 años de historia de la familia.</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- Architecture & Engineering -->
    <section class="project-panel">
      <h2 data-section-2-title>Arquitectura de software y estándares de ingeniería</h2>
      <p data-section-2-intro>
        Desarrollado como un <strong>monorepo modular</strong> siguiendo principios de <em>Deep Modules</em> (interfaces estrechas respaldadas por implementaciones ricas) y separación de responsabilidades:
      </p>

      <div class="arch-cards-grid">
        <div class="arch-card">
          <div class="arch-header">
            <span class="arch-icon">⚡</span>
            <h4>Frontend (Angular 22)</h4>
          </div>
          <ul class="bullet-list">
            <li><strong>Standalone Components:</strong> Estructura ligera y modular sin módulos NgModules redundantes.</li>
            <li><strong>Angular Signals:</strong> Reactividad atómica con <code>signal()</code> y <code>computed()</code> para la cesta de compra.</li>
            <li><strong>Control Flow nativo:</strong> Sintaxis moderna <code>@if</code> y <code>@for</code> para optimizar renderizado.</li>
            <li><strong>Seams & Adapters:</strong> Desacople de APIs del navegador (<code>CartStorageAdapter</code>) para compatibilidad cliente/SSR.</li>
          </ul>
        </div>

        <div class="arch-card">
          <div class="arch-header">
            <span class="arch-icon">🚀</span>
            <h4>Servidor SSR (Node.js & Express)</h4>
          </div>
          <ul class="bullet-list">
            <li><strong>Server-Side Rendering:</strong> Angular SSR con Express para servir HTML hidratado y rápido.</li>
            <li><strong>Optimización LCP:</strong> Primer renderizado visual instantáneo sin pantalla en blanco para usuarios móviles.</li>
            <li><strong>SEO Gastronómico:</strong> Metadatos Open Graph y títulos dinámicos indexables para Google.</li>
            <li><strong>Caché estática:</strong> Entrega ultraeficiente de activos multimedia y fotos reales del catálogo.</li>
          </ul>
        </div>

        <div class="arch-card">
          <div class="arch-header">
            <span class="arch-icon">🏛️</span>
            <h4>Contratos de Dominio (@cal-sarda/domain)</h4>
          </div>
          <ul class="bullet-list">
            <li><strong>Paquete de Dominio compartido:</strong> TypeScript estricto para entidades canónicas de negocio.</li>
            <li><strong>Entidades de negocio:</strong> <code>Producto</code>, <code>Lote</code>, <code>Obrador</code>, <code>Cesta</code>, <code>Pedido</code>, <code>Cliente</code>.</li>
            <li><strong>Glosario de negocio canónico:</strong> Mapeo formal de conceptos tradicionales a modelos de datos.</li>
            <li><strong>Vitest Test Suite:</strong> Suite de pruebas unitarias automatizadas para la lógica de cálculo y filtrado.</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- Source Code & Repository -->
    <section class="project-panel">
      <h2 data-section-3-title>Repositorio y código fuente</h2>
      <p data-section-3-intro>El código fuente completo del monorepo está disponible en GitHub:</p>
      <div class="code-terminal">
        <div class="terminal-bar">
          <span class="dot red"></span>
          <span class="dot yellow"></span>
          <span class="dot green"></span>
          <span class="terminal-title">bash · monorepo cal-sarda</span>
        </div>
        <pre><code data-terminal-code># Clonar monorepo
git clone https://github.com/alexBarrera457/Prototipo-Cal-Sard-.git
cd Prototipo-Cal-Sard-

# Instalar dependencias del monorepo y paquetes
npm install

# Iniciar servidor Angular en desarrollo con SSR
npm start</code></pre>
      </div>
      <div class="action-buttons-row">
        <a class="button primary" href="https://github.com/alexBarrera457/Prototipo-Cal-Sard-" target="_blank" rel="noopener noreferrer" data-repo-btn>
          Ver repositorio en GitHub ↗
        </a>
        <a class="button" href="/#contact" data-contact-btn>
          Contactar conmigo →
        </a>
      </div>
    </section>

    <!-- Conclusion Panel -->
    <section class="project-panel conclusion-panel">
      <h2 data-section-4-title>Conclusión y balance profesional</h2>
      <p data-section-4-text>
        Este proyecto une mi experiencia práctica en el sector comercio y atención al cliente con
        estándares de ingeniería de software contemporáneos: crear un producto digital real, fiel a la identidad de un negocio
        con casi 100 años de historia, con arquitectura limpia y tecnologías punteras del ecosistema web.
      </p>
      <div class="conclusion-cta">
        <a class="button primary" href="/#contact" data-cta-btn>Hablar sobre este proyecto →</a>
      </div>
    </section>
  </main>

  <footer class="project-footer">
    <div class="container project-footer-inner">
      <span>Cal Sardà · Proyecto de Software Real</span>
      <a href="/" data-footer-back>← Volver al portfolio</a>
    </div>
  </footer>

