---
import '../styles/global.css';

const skills = ['Interfaces web responsive', 'Bases de datos', 'VS Code', 'Herramientas colaborativas', 'Sistemas operativos', 'Programación backend', 'Depuración de código'];
const softSkills = ['Trabajo en equipo', 'Empatía', 'Responsabilidad', 'Gestión del tiempo'];
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Currículum de Àlex Barrera Sardà." />
    <title>Currículum · Àlex Barrera Sardà</title>
  </head>
  <body class="cv-page">
    <main class="cv-sheet">
      <header class="cv-header">
        <div class="cv-identity">
          <img class="cv-photo" src="/images/profile.jpg" alt="Foto de Àlex Barrera Sardà" />
          <div>
            <a class="cv-back" href="/">← Volver al portfolio</a>
            <h1><span class="cv-name-line">Àlex Barrera</span><em>Sardà</em></h1>
            <p class="cv-role">Desarrollador de Aplicaciones Web</p>
          </div>
        </div>
        <div class="cv-contact">
          <span>Barcelona, España</span>
          <span>+34 605 16 70 05</span>
          <a href="mailto:salexbarrera@gmail.com">salexbarrera@gmail.com</a>
          <a href="https://www.linkedin.com/in/%C3%A0lex-barrera-sard%C3%A0-35b088397/" target="_blank" rel="noopener noreferrer">LinkedIn ↗</a>
        </div>
      </header>

      <section class="cv-section cv-intro">
        <span class="cv-label">Objetivo profesional</span>
        <p>Estudiante de Desarrollo de Aplicaciones Web con motivación por aprender y crecer en el ámbito tecnológico. Busco una oportunidad de prácticas para aplicar mis conocimientos, trabajar en equipo y seguir mejorando mis competencias digitales y profesionales.</p>
      </section>

      <div class="cv-columns">
        <div>
          <section class="cv-section">
            <span class="cv-label">Experiencia laboral</span>
            <article class="cv-entry"><div class="cv-entry-meta">2025 · 6 meses</div><h2>Canguro</h2><p>Cuidador de niños</p></article>
            <article class="cv-entry"><div class="cv-entry-meta">2024 · 5 meses</div><h2>Cal Sardà</h2><p>Dependiente</p></article>
          </section>
          <section class="cv-section">
            <span class="cv-label">Formación académica</span>
            <article class="cv-entry"><div class="cv-entry-meta">2025 — 2027</div><h2>Desarrollo de Aplicaciones Web</h2><p>Stucom · Barcelona · Segundo curso</p></article>
            <article class="cv-entry"><div class="cv-entry-meta">2023 — 2025</div><h2>Bachillerato Tecnológico</h2><p>Dominiques Barcelona</p></article>
          </section>
          <section class="cv-section">
            <span class="cv-label">Certificaciones</span>
            <p>Masterclass: Prompting y cartografía de herramientas de Inteligencia Artificial · Cibernarium, 2025.</p>
            <p>Inteligencia Artificial con Python y Hugging Face Transformers · Cibernarium, 2025.</p>
          </section>
        </div>
        <aside>
          <section class="cv-section"><span class="cv-label">Competencias técnicas</span><div class="cv-skills">{skills.map((skill) => <span>{skill}</span>)}</div></section>
          <section class="cv-section"><span class="cv-label">Habilidades personales</span><div class="cv-skills">{softSkills.map((skill) => <span>{skill}</span>)}</div></section>
          <section class="cv-section"><span class="cv-label">Idiomas</span><p><strong>Catalán:</strong> Nativo (C1)</p><p><strong>Castellano:</strong> Nativo</p><p><strong>Inglés:</strong> B1</p></section>
          <section class="cv-section"><span class="cv-label">Otros datos</span><p>Entusiasta del fútbol, aficionado a la música y a los videojuegos.</p></section>
        </aside>
      </div>

      <footer class="cv-footer">
        <span>Àlex Barrera Sardà · 2026</span>
        <div class="cv-actions">
          <div class="language-switcher" aria-label="Idioma">
            <button type="button" data-language="es" aria-pressed="true">ES</button>
            <button type="button" data-language="ca" aria-pressed="false">CA</button>
            <button type="button" data-language="en" aria-pressed="false">EN</button>
          </div>
          <button type="button" data-download-cv>Descargar CV ↓</button>
          <button type="button" data-print-cv onclick="window.print()">Imprimir</button>
        </div>
      </footer>
    </main>
    <dialog class="cv-preview" data-cv-preview>
      <div class="cv-preview-header">
        <h2>Vista previa del CV</h2>
        <button type="button" class="cv-preview-close" data-close-preview aria-label="Cerrar vista previa">×</button>
      </div>
      <iframe title="Vista previa del currículum" data-preview-frame></iframe>
      <div class="cv-preview-actions">
        <button type="button" data-close-preview>Volver</button>
        <button type="button" class="cv-preview-download" data-confirm-download>Descargar PDF ↓</button>
      </div>
    </dialog>
  </body>
</html>

<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script>
  const cvTranslations = {
    es: ['← Volver al portfolio', 'Desarrollador de Aplicaciones Web', 'Objetivo profesional', 'Estudiante de Desarrollo de Aplicaciones Web con motivación por aprender y crecer en el ámbito tecnológico. Busco una oportunidad de prácticas para aplicar mis conocimientos, trabajar en equipo y seguir mejorando mis competencias digitales y profesionales.', 'Experiencia laboral', 'Formación académica', 'Certificaciones', 'Competencias técnicas', 'Habilidades personales', 'Idiomas', 'Otros datos', 'Descargar CV ↓', 'Imprimir', 'Vista previa del CV', 'Cerrar vista previa', 'Vista previa del currículum', 'Volver', 'Descargar PDF ↓'],
    ca: ['← Tornar al portfoli', 'Desenvolupador d’Aplicacions Web', 'Objectiu professional', 'Estudiant de Desenvolupament d’Aplicacions Web amb motivació per aprendre i créixer en l’àmbit tecnològic. Busco una oportunitat de pràctiques per aplicar els meus coneixements, treballar en equip i continuar millorant les meves competències digitals i professionals.', 'Experiència laboral', 'Formació acadèmica', 'Certificacions', 'Competències tècniques', 'Habilitats personals', 'Idiomes', 'Altres dades', 'Descarregar CV ↓', 'Imprimir', 'Vista prèvia del CV', 'Tancar la vista prèvia', 'Vista prèvia del currículum', 'Tornar', 'Descarregar PDF ↓'],
    en: ['← Back to portfolio', 'Web Application Developer', 'Professional objective', 'Web Application Development student motivated to learn and grow in technology. I am looking for an internship opportunity to apply my knowledge, work in a team and continue improving my digital and professional skills.', 'Work experience', 'Education', 'Certifications', 'Technical skills', 'Soft skills', 'Languages', 'Additional information', 'Download résumé ↓', 'Print', 'Résumé preview', 'Close preview', 'Résumé preview', 'Back', 'Download PDF ↓']
  };
  const cvLanguageButtons = document.querySelectorAll<HTMLButtonElement>('[data-language]');
  const cvDetailedTranslations = {
    es: { titles: ['Canguro', 'Cal Sardà', 'Desarrollo de Aplicaciones Web', 'Bachillerato Tecnológico'], entries: ['Cuidador de niños', 'Dependiente', 'Stucom · Barcelona · Segundo curso', 'Dominiques Barcelona'], certifications: ['Masterclass: Prompting y cartografía de herramientas de Inteligencia Artificial · Cibernarium, 2025.', 'Inteligencia Artificial con Python y Hugging Face Transformers · Cibernarium, 2025.'], languages: ['Catalán: Nativo (C1)', 'Castellano: Nativo', 'Inglés: B1'], other: 'Entusiasta del fútbol, aficionado a la música y a los videojuegos.', skills: ['Interfaces web responsive', 'Bases de datos', 'VS Code', 'Herramientas colaborativas', 'Sistemas operativos', 'Programación backend', 'Depuración de código', 'Trabajo en equipo', 'Empatía', 'Responsabilidad', 'Gestión del tiempo'] },
    ca: { titles: ['Cangur', 'Cal Sardà', 'Desenvolupament d’Aplicacions Web', 'Batxillerat Tecnològic'], entries: ['Cuidador d’infants', 'Dependent', 'Stucom · Barcelona · Segon curs', 'Dominiques Barcelona'], certifications: ['Masterclass: Prompting i cartografia d’eines d’Intel·ligència Artificial · Cibernarium, 2025.', 'Intel·ligència Artificial amb Python i Hugging Face Transformers · Cibernarium, 2025.'], languages: ['Català: Natiu (C1)', 'Castellà: Natiu', 'Anglès: B1'], other: 'Entusiasta del futbol, aficionat a la música i als videojocs.', skills: ['Interfícies web responsive', 'Bases de dades', 'VS Code', 'Eines col·laboratives', 'Sistemes operatius', 'Programació backend', 'Depuració de codi', 'Treball en equip', 'Empatia', 'Responsabilitat', 'Gestió del temps'] },
    en: { titles: ['Childcare', 'Cal Sardà', 'Web Application Development', 'Technological Baccalaureate'], entries: ['Childcare worker', 'Shop assistant', 'Stucom · Barcelona · Second year', 'Dominiques Barcelona'], certifications: ['Masterclass: Prompting and mapping Artificial Intelligence tools · Cibernarium, 2025.', 'Artificial Intelligence with Python and Hugging Face Transformers · Cibernarium, 2025.'], languages: ['Catalan: Native (C1)', 'Spanish: Native', 'English: B1'], other: 'Football enthusiast, music lover and videogame fan.', skills: ['Responsive web interfaces', 'Databases', 'VS Code', 'Collaboration tools', 'Operating systems', 'Backend programming', 'Code debugging', 'Teamwork', 'Empathy', 'Responsibility', 'Time management'] }
  };
  const cvSetLanguage = (language: 'es' | 'ca' | 'en') => {
    const copy = cvTranslations[language];
    const detail = cvDetailedTranslations[language];
    document.querySelector('.cv-back')!.textContent = copy[0];
    document.querySelector('.cv-role')!.textContent = copy[1];
    document.querySelector('.cv-intro .cv-label')!.textContent = copy[2];
    document.querySelector('.cv-intro p')!.textContent = copy[3];
    document.querySelectorAll('.cv-label').forEach((label, index) => { if (index > 0) label.textContent = copy[index + 3]; });
    document.querySelectorAll('.cv-entry p').forEach((paragraph, index) => { if (detail.entries[index]) paragraph.textContent = detail.entries[index]; });
    document.querySelectorAll('.cv-entry h2').forEach((heading, index) => { if (detail.titles[index]) heading.textContent = detail.titles[index]; });
    document.querySelectorAll('.cv-columns > div > .cv-section:nth-child(3) > p').forEach((paragraph, index) => { if (detail.certifications[index]) paragraph.textContent = detail.certifications[index]; });
    document.querySelectorAll('.cv-skills span').forEach((skill, index) => { if (detail.skills[index]) skill.textContent = detail.skills[index]; });
    const languageParagraphs = document.querySelectorAll('.cv-columns aside .cv-section:nth-child(3) p');
    languageParagraphs.forEach((paragraph, index) => { if (detail.languages[index]) paragraph.textContent = detail.languages[index]; });
    const otherDetails = document.querySelector('.cv-columns aside .cv-section:last-child p');
    if (otherDetails) otherDetails.textContent = detail.other;
    document.querySelector('[data-download-cv]')!.textContent = copy[11];
    document.querySelector('[data-print-cv]')!.textContent = copy[12];
    document.querySelector('.cv-preview-header h2')!.textContent = copy[13];
    document.querySelector('[data-close-preview]')!.setAttribute('aria-label', copy[14]);
    document.querySelector('[data-preview-frame]')!.setAttribute('title', copy[15]);
    document.querySelector('.cv-preview-actions [data-close-preview]')!.textContent = copy[16];
    document.querySelector('[data-confirm-download]')!.textContent = copy[17];
    document.title = language === 'en' ? 'Résumé · Àlex Barrera Sardà' : language === 'ca' ? 'Currículum · Àlex Barrera Sardà' : 'Currículum · Àlex Barrera Sardà';
    const cvDescriptions = { es: 'Currículum de Àlex Barrera Sardà.', ca: 'Currículum d’Àlex Barrera Sardà.', en: 'Résumé of Àlex Barrera Sardà.' };
    document.querySelector('meta[name="description"]')?.setAttribute('content', cvDescriptions[language]);
    document.documentElement.lang = language;
    cvLanguageButtons.forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.language === language)));
    localStorage.setItem('portfolio-language', language);
  };
  const cvStoredLanguage = localStorage.getItem('portfolio-language');
  const cvInitialLanguage = cvStoredLanguage === 'ca' || cvStoredLanguage === 'en' ? cvStoredLanguage : 'es';
  cvLanguageButtons.forEach((button) => button.addEventListener('click', () => cvSetLanguage((button.dataset.language || 'es') as 'es' | 'ca' | 'en')));
  cvSetLanguage(cvInitialLanguage);

  const downloadButton = document.querySelector<HTMLButtonElement>('[data-download-cv]');
  const previewDialog = document.querySelector<HTMLDialogElement>('[data-cv-preview]');
  const previewFrame = document.querySelector<HTMLIFrameElement>('[data-preview-frame]');
  const confirmDownload = document.querySelector<HTMLButtonElement>('[data-confirm-download]');
  let previewUrl = '';

  document.querySelectorAll<HTMLButtonElement>('[data-close-preview]').forEach((button) => {
    button.addEventListener('click', () => {
      previewDialog?.close();
      if (previewUrl) URL.revokeObjectURL(previewUrl);
      previewUrl = '';
      if (previewFrame) previewFrame.removeAttribute('src');
    });
  });

  confirmDownload?.addEventListener('click', () => {
    if (!previewUrl) return;
    const link = document.createElement('a');
    link.href = previewUrl;
    link.download = 'curriculum-alex-barrera-sarda.pdf';
    link.click();
  });

  downloadButton?.addEventListener('click', async () => {
    const browserWindow = window as Window & {
      html2canvas?: (element: HTMLElement, options: Record<string, unknown>) => Promise<HTMLCanvasElement>;
      jspdf?: { jsPDF: new (options: Record<string, unknown>) => { addImage: (...args: unknown[]) => void; output: (type: string) => Blob } };
    };
    const canvasGenerator = browserWindow.html2canvas;
    const jsPDF = browserWindow.jspdf?.jsPDF;
    if (!canvasGenerator || !jsPDF) {
      window.alert('No se ha podido cargar el generador del PDF. Recarga la página e inténtalo de nuevo.');
      return;
    }
    const actions = document.querySelector<HTMLElement>('.cv-actions');
    const sheet = document.querySelector<HTMLElement>('.cv-sheet');
    if (!sheet) return;
    downloadButton.disabled = true;
    if (actions) actions.style.display = 'none';
    sheet.classList.add('cv-pdf-mode');
    try {
      await document.fonts.ready;
      const canvas = await canvasGenerator(sheet, { scale: 2, useCORS: true, backgroundColor: '#ffffff' });
      const pdf = new jsPDF({ unit: 'mm', format: 'a4', orientation: 'portrait' });
      const pageWidth = 210;
      const pageHeight = 297;
      const scale = Math.min(pageWidth / canvas.width, pageHeight / canvas.height);
      const imageWidth = canvas.width * scale;
      const imageHeight = canvas.height * scale;
      pdf.addImage(
        canvas.toDataURL('image/jpeg', 0.98),
        'JPEG',
        (pageWidth - imageWidth) / 2,
        (pageHeight - imageHeight) / 2,
        imageWidth,
        imageHeight
      );
      if (previewUrl) URL.revokeObjectURL(previewUrl);
      previewUrl = URL.createObjectURL(pdf.output('blob'));
      if (previewFrame) previewFrame.src = previewUrl;
      previewDialog?.showModal();
    } finally {
      sheet.classList.remove('cv-pdf-mode');
      if (actions) actions.style.display = 'flex';
      downloadButton.disabled = false;
    }
  });
</script>

<style>
  .cv-page { background: var(--paper-deep); }
  .cv-sheet { width: min(920px, calc(100% - 2rem)); margin: 2rem auto; padding: 2.2rem; background: var(--paper); border-top: 8px solid var(--coral); box-shadow: 0 20px 60px rgba(19,34,56,.12); }
  .cv-header { display: grid; grid-template-columns: minmax(0, 1fr) 190px; align-items: end; gap: 2.5rem; padding: 1.4rem 1.4rem 2rem; border: 1px solid var(--line); border-radius: 18px; background: linear-gradient(135deg, rgba(52,120,246,.08), rgba(143,211,182,.13)); }
  .cv-identity { display: flex; align-items: center; gap: 1.5rem; min-width: 0; }
  .cv-identity > div { order: 1; }
  .cv-photo { order: 2; width: 190px; height: 190px; flex: 0 0 190px; object-fit: cover; border: 6px solid var(--paper); outline: 1px solid var(--line); border-radius: 50%; }
  .cv-back { color: var(--coral-dark); font: .68rem var(--mono); text-decoration: none; }
  .cv-header h1 { margin: 1.2rem 0 .3rem; font-size: clamp(2.7rem, 5vw, 4.8rem); }
  .cv-name-line { display: block; white-space: nowrap; }
  .cv-header h1 em { color: var(--coral); font-style: italic; }
  .cv-role { display: block; margin-top: 1.1rem; padding: .2rem 0 .2rem .8rem; border-left: 4px solid var(--coral); color: var(--coral-dark); font: 600 1.2rem var(--sans); letter-spacing: .01em; }
  .cv-contact { display: grid; align-content: end; justify-items: end; gap: .35rem; min-width: 0; padding: .9rem 0 .9rem 1.25rem; border-left: 1px solid var(--line); color: var(--muted); font-size: .78rem; overflow-wrap: anywhere; }
  .cv-contact a { color: var(--coral-dark); text-decoration: none; font-weight: 600; }
  .cv-section { padding: 2rem 0; border-bottom: 1px solid var(--line); }
  .cv-label { display: block; margin-bottom: 1rem; color: var(--coral-dark); font: .68rem var(--mono); letter-spacing: .14em; text-transform: uppercase; }
  .cv-intro p, .cv-section > p { max-width: 44rem; color: var(--muted); line-height: 1.75; }
  .cv-columns { display: grid; grid-template-columns: 1.25fr .75fr; gap: 3rem; }
  .cv-entry { margin-bottom: 1.25rem; padding-left: 1rem; border-left: 2px solid var(--sage); }
  .cv-entry-meta { color: var(--coral-dark); font: .68rem var(--mono); }
  .cv-entry h2 { margin: .35rem 0 .1rem; color: var(--ink); font: 400 1.55rem var(--serif); }
  .cv-entry p { color: var(--muted); line-height: 1.55; }
  .cv-section > p + p { margin-top: .8rem; }
  .cv-skills { display: flex; flex-wrap: wrap; gap: .5rem; }
  .cv-skills span { padding: .4rem .65rem; border: 1px solid var(--line); border-radius: 999px; color: var(--ink); font: .68rem var(--mono); line-height: 1.35; }
  .cv-footer { display: flex; justify-content: space-between; align-items: center; padding-top: 1.5rem; color: var(--muted); font-size: .75rem; }
  .cv-actions { display: flex; gap: .55rem; }
  .cv-footer button { border: 1px solid var(--ink); border-radius: 999px; padding: .65rem .9rem; background: transparent; color: var(--ink); cursor: pointer; font: .7rem var(--mono); }
  .cv-footer button:first-child { background: var(--coral); border-color: var(--coral); color: white; }
  .cv-footer button:hover { background: var(--ink); color: var(--paper); }
  @media (max-width: 650px) { .cv-sheet { padding: 1.2rem; border-top-width: 6px; } .cv-header, .cv-columns { display: grid; grid-template-columns: 1fr; } .cv-header { padding: 1rem; } .cv-identity { align-items: flex-start; flex-direction: column; gap: 1rem; } .cv-photo { width: 150px; height: 150px; flex-basis: 150px; } .cv-role { font-size: 1rem; } .cv-contact { justify-items: start; padding: .9rem 0 0; border-left: 0; border-top: 1px solid var(--line); } .cv-footer { align-items: flex-start; flex-direction: column; gap: .8rem; } .cv-actions { flex-wrap: wrap; } }
  @page { size: A4; margin: 0; }
  .cv-pdf-mode { width: 794px; min-height: 0; margin: 0; padding: 40px 38px 30px; border-top-width: 5px; box-shadow: none; }
  .cv-pdf-mode .cv-header { grid-template-columns: minmax(0, 1fr) 150px; gap: 1rem; padding: 1.1rem 1.1rem 1.3rem; border-radius: 12px; }
  .cv-pdf-mode .cv-identity { gap: .85rem; }
  .cv-pdf-mode .cv-photo { width: 132px; height: 132px; flex-basis: 132px; border-width: 4px; }
  .cv-pdf-mode .cv-header h1 { margin: .55rem 0 .15rem; font-size: 2.75rem; line-height: .9; }
  .cv-pdf-mode .cv-name-line { white-space: normal; }
  .cv-pdf-mode .cv-role { margin-top: .6rem; padding: .15rem 0 .15rem .55rem; font-size: .86rem; }
  .cv-pdf-mode .cv-contact { gap: .25rem; padding-left: .7rem; font-size: .61rem; }
  .cv-pdf-mode .cv-section { padding: 1.35rem 0; }
  .cv-pdf-mode .cv-label { margin-bottom: .7rem; font-size: .63rem; }
  .cv-pdf-mode .cv-intro p, .cv-pdf-mode .cv-section > p, .cv-pdf-mode .cv-entry p { line-height: 1.58; }
  .cv-pdf-mode .cv-entry { margin-bottom: 1rem; padding-left: .85rem; }
  .cv-pdf-mode .cv-entry-meta { font-size: .63rem; }
  .cv-pdf-mode .cv-entry h2 { margin: .22rem 0 .05rem; color: var(--ink); font-size: 1.32rem; }
  .cv-pdf-mode .cv-columns { gap: 2rem; }
  .cv-pdf-mode .cv-skills { gap: .38rem; }
  .cv-pdf-mode .cv-skills span { padding: .32rem .52rem; font-size: .61rem; }
  .cv-pdf-mode .cv-section > p + p { margin-top: .65rem; }
  .cv-pdf-mode .cv-footer { padding-top: 1.05rem; font-size: .66rem; }
  .cv-pdf-mode .cv-back, .cv-pdf-mode .cv-actions { display: none; }
  .cv-pdf-mode h1 { color: var(--ink); opacity: 1; transform: none; animation: none !important; }
  .cv-pdf-mode h1 em { color: var(--coral); }
  .cv-pdf-mode * { transition: none !important; }
  .cv-pdf-mode .cv-section, .cv-pdf-mode .cv-entry, .cv-pdf-mode .cv-header { break-inside: avoid; }
  .cv-preview { width: min(900px, calc(100% - 2rem)); height: min(92vh, 900px); padding: 0; border: 1px solid var(--line); border-radius: 14px; background: var(--paper); color: var(--ink); box-shadow: 0 24px 80px rgba(19,34,56,.3); }
  .cv-preview::backdrop { background: rgba(19,34,56,.72); }
  .cv-preview-header, .cv-preview-actions { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: .9rem 1rem; }
  .cv-preview-header { border-bottom: 1px solid var(--line); }
  .cv-preview-header h2 { font: 400 1.2rem var(--serif); }
  .cv-preview-close { border: 0; background: transparent; color: var(--ink); cursor: pointer; font-size: 1.6rem; line-height: 1; }
  .cv-preview iframe { display: block; width: 100%; height: calc(100% - 116px); border: 0; background: #525659; }
  .cv-preview-actions { justify-content: flex-end; border-top: 1px solid var(--line); }
  .cv-preview-actions button { border: 1px solid var(--ink); border-radius: 999px; padding: .65rem .9rem; background: transparent; color: var(--ink); cursor: pointer; font: .7rem var(--mono); }
  .cv-preview-actions .cv-preview-download { border-color: var(--coral); background: var(--coral); color: white; }
  @media (max-width: 650px) {
    .cv-page { min-width: 960px; overflow-x: auto; }
    .cv-sheet { width: 920px; margin: 2rem auto; padding: 2.2rem; border-top-width: 8px; }
    .cv-page .cv-pdf-mode { width: 794px; margin: 0; padding: 40px 38px 30px; }
    .cv-header { grid-template-columns: minmax(0, 1fr) 190px; gap: 2.5rem; padding: 1.4rem 1.4rem 2rem; }
    .cv-identity { align-items: center; flex-direction: row; gap: 1.5rem; }
    .cv-identity > div { width: auto; order: 1; }
    .cv-photo { order: 2; width: 190px; height: 190px; flex-basis: 190px; border-width: 6px; }
    .cv-header h1 { margin: 1.2rem 0 .3rem; font-size: 4.8rem; line-height: normal; }
    .cv-name-line { white-space: nowrap; }
    .cv-role { margin-top: 1.1rem; font-size: 1.2rem; }
