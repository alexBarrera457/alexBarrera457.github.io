    }

    .view-badge {
      position: absolute;
      top: 0.75rem;
      left: 0.75rem;
      background: rgba(19, 34, 56, 0.85);
      color: #ffffff;
      font: 600 0.65rem var(--mono);
      letter-spacing: 0.04em;
      padding: 0.25rem 0.65rem;
