      box-shadow: 0 12px 28px rgba(19, 34, 56, 0.08);
    }

    .view-image-wrap {
      position: relative;
      background: #0f172a;
      overflow: hidden;
      aspect-ratio: 16 / 10;
    }

    .view-image-wrap img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: top center;
      display: block;
      transition: transform 0.3s ease;
    }

    .view-card:hover .view-image-wrap img {
