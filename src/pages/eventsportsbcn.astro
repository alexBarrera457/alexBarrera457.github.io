      box-shadow: 0 10px 30px rgba(19, 34, 56, 0.02);
    }

    .project-panel h2 {
      font: 400 clamp(1.6rem, 2.8vw, 2.2rem) var(--serif);
      color: var(--ink);
      margin: 0 0 0.8rem;
