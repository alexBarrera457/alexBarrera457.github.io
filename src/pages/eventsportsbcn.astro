---
import BaseLayout from '../layouts/BaseLayout.astro';
import LanguageSwitcher from '../components/LanguageSwitcher.astro';

const stack = ['PHP 8', 'MySQL / MariaDB', 'Arquitectura MVC', 'JavaScript', 'CSS3 Responsive', 'Apache / XAMPP', 'Control de Aforo'];

const appViews = [
  {
    id: 'home',
    title: 'Portal Principal & Portada',
    badge: 'Landing & Featured Sports',
    desc: 'Página de inicio con cabecera visual, acceso rápido a deportes destacados y accesos directos para organizadores de torneos.',
    img: '/images/eventsports-home.jpg'
  },
  {
    id: 'basket',
    title: 'Catálogo de Torneos con Filtros',
    badge: 'Búsqueda & Calendario',
    desc: 'Módulo de exploración deportiva con buscador en tiempo real, selector de fechas, ordenación alfabética y tarjetas informativas con aforo y sede.',
    img: '/images/eventsports-basket.jpg'
  },
  {
    id: 'detalle',
    title: 'Ficha Detallada & Reserva de Plaza',
    badge: 'Ficha de Evento',
    desc: 'Vista pormenorizada del evento con fotografía, horarios, dirección exacta en Barcelona, plazas totales y disponibles, enlace a Google Maps y llamada a la inscripción.',
    img: '/images/eventsports-detalle.jpg'
  },
  {
    id: 'manager',
    title: 'Panel del Organizador (Manager)',
    badge: 'Gestión CRUD de Eventos',
    desc: 'Panel de control exclusivo para organizadores deportivos: creación de nuevas actividades, control de aforo, edición de datos y eliminación.',
    img: '/images/eventsports-manager.jpg'
  },
  {
    id: 'login',
    title: 'Autenticación & Control de Roles',
    badge: 'Seguridad & Sesiones',
    desc: 'Sistema de acceso con hashing seguro de contraseñas, gestión de sesiones PHP, política de cookies y pantallas de registro diferenciadas.',
    img: '/images/eventsports-login.jpg'
  }
];
---

<BaseLayout
  title="EventSportsBCN · Plataforma de Gestión Deportiva en Barcelona"
  description="EventSportsBCN — Aplicación web full-stack para el descubrimiento, inscripción y gestión de eventos deportivos en Barcelona construida con PHP, MySQL y arquitectura MVC."
  ogImage="https://alexbarrera457.github.io/images/eventsports-home.jpg"
  canonicalUrl="https://alexbarrera457.github.io/eventsportsbcn"
  bodyClass="project-page"
>
  <header class="project-header">
    <div class="container project-header-inner">
      <div class="header-nav-bar">
        <a class="back-link" href="/">← Volver al portfolio</a>
        <LanguageSwitcher />
      </div>

      <div class="header-hero">
        <span class="eyebrow project-eyebrow">Proyecto académico · Aplicación real · 2026</span>
        <h1 class="project-title">EventSportsBCN</h1>
        <p class="lead">
          Plataforma web full-stack para descubrir, inscribirse y gestionar eventos y torneos deportivos en <strong>Barcelona</strong>.
          Construida con <strong>PHP 8</strong>, base de datos relacional <strong>MySQL</strong> y arquitectura <strong>MVC</strong> pura
          con control de aforo en tiempo real y roles de usuario diferenciados.
        </p>
        <div class="stack-list">
          {stack.map((item) => <span class="stack-pill">{item}</span>)}
        </div>
        <div class="header-actions">
          <a class="button primary" href="https://github.com/alexBarrera457/ProjectEventSportsBCN" target="_blank" rel="noopener noreferrer" data-header-repo-btn>
            Ver repositorio en GitHub ↗
          </a>
          <a class="button" href="#capturas-reales" data-header-gallery-btn>
            Explorar capturas reales ↓
          </a>
        </div>
      </div>
    </div>
  </header>

  <!-- Real Web Application Hero Showcase -->
  <div class="container cover-wrap" id="capturas-reales">
    <div class="browser-showcase">
      <div class="browser-bar">
        <div class="browser-controls">
          <span class="dot close"></span>
          <span class="dot min"></span>
          <span class="dot max"></span>
        </div>
        <div class="browser-url">
          <span class="url-lock">🔒</span>
          <span class="url-text">http://localhost/ProjectEventSportsBCN/View/HTML/Pages/HomeMenu.php</span>
          <span class="url-badge">PHP 8 · MySQL · MVC Activo</span>
        </div>
        <div class="browser-actions">
          <span class="live-dot"></span>
          <span class="live-text">Captura real de la app</span>
        </div>
      </div>
      <div class="browser-screen">
        <img
          id="main-showcase-img"
          src="/images/eventsports-home.jpg"
          alt="Captura real de la plataforma deportiva EventSportsBCN"
          class="showcase-img"
          width="1440"
          height="900"
          fetchpriority="high"
          decoding="async"
        />
        <div class="showcase-floating-badge">
          <span class="floating-icon">🏆</span>
          <div>
            <strong>Plataforma Deportiva Operativa</strong>
            <span>Gestión de eventos, torneos y aforo en Barcelona</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <main class="container project-content">
    <!-- Real Views Tabs & Gallery Section -->
    <section class="project-panel gallery-panel">
      <div class="panel-header-row">
        <div>
          <h2 data-gallery-title>Capturas reales de la aplicación</h2>
          <p data-gallery-subtitle>
            Vistas reales de la plataforma deportiva capturadas en entorno local, reflejando el flujo integral desde el usuario deportista hasta el gestor deportivo:
          </p>
        </div>
      </div>

      <div class="views-grid">
        {appViews.map((view) => (
          <article class="view-card" data-view-id={view.id}>
            <div class="view-image-wrap">
              <span class="view-badge">{view.badge}</span>
              <img src={view.img} alt={view.title} loading="lazy" decoding="async" width="800" height="500" />
            </div>
            <div class="view-info">
              <h4>{view.title}</h4>
              <p>{view.desc}</p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- Key Impact Metrics -->
    <section class="metrics-grid">
      <div class="metric-card">
        <span class="metric-num">2 Roles</span>
        <span class="metric-label" data-metric-1-label>Roles Diferenciados</span>
        <p class="metric-desc" data-metric-1-desc>Acceso segregado: Usuario (reserva y seguimiento) y Manager (administración integral de eventos).</p>
      </div>
      <div class="metric-card">
        <span class="metric-num">100% MVC</span>
        <span class="metric-label" data-metric-2-label>Arquitectura Modular</span>
        <p class="metric-desc" data-metric-2-desc>Separación estricta entre Controladores POO en PHP, Modelos de datos PDO y Vistas HTML/CSS.</p>
      </div>
      <div class="metric-card">
        <span class="metric-num">5 Deportes</span>
        <span class="metric-label" data-metric-3-label>Disciplinas Cubiertas</span>
        <p class="metric-desc" data-metric-3-desc>Fútbol, Baloncesto, Pádel, Tenis y Golf con filtrado dinámico por fecha y ordenación alfabética.</p>
      </div>
      <div class="metric-card">
        <span class="metric-num">Real-Time</span>
        <span class="metric-label" data-metric-4-label>Control de Aforo</span>
        <p class="metric-desc" data-metric-4-desc>Cálculo exacto de plazas totales vs plazas disponibles con integridad referencial en MySQL.</p>
      </div>
    </section>

    <!-- Business Context & Motivation -->
    <section class="project-panel">
      <h2 data-section-1-title>Contexto del proyecto: digitalizar el deporte amateur en Barcelona</h2>
      <p data-section-1-intro>
        En el ecosistema deportivo amateur de Barcelona coexisten clubes municipales, pistas abiertas y organizadores independientes.
        La falta de un canal unificado suele provocar dificultades logísticas tanto a los deportistas que buscan unirse a partidos como a los gestores que intentan completar convocatorias:
      </p>
      <div class="status-grid">
        <div class="status-box">
          <h3 data-status-problem-title>⚠️ Retos de la organización tradicional</h3>
          <ul class="bullet-list" data-status-problem-list>
            <li>Gestión informal de convocatorias a través de grupos de mensajería dispersos.</li>
            <li>Incertidumbre constante sobre el aforo real y cancelaciones de última hora sin recuento.</li>
            <li>Falta de visibilidad para torneos de disciplinas como pádel, tenis o golf en instalaciones municipales.</li>
            <li>Ausencia de un registro histórico de eventos inscritos o guardados por parte del jugador.</li>
          </ul>
        </div>
        <div class="status-box success">
          <h3 data-status-solution-title>💡 Solución implementada en EventSportsBCN</h3>
          <ul class="bullet-list" data-status-solution-list>
            <li>Catálogo centralizado clasificado por categorías deportivas con buscador reactivo y selector de fecha.</li>
            <li>Panel de control CRUD para organizadores con publicación inmediata de convocatorias y dirección física.</li>
            <li>Control riguroso de plazas en base de datos con vinculación directa entre usuarios y eventos.</li>
            <li>Área privada con secciones de "Eventos apuntados", "Eventos guardados" y "Deportes seguidos".</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- Architecture & Engineering -->
    <section class="project-panel">
      <h2 data-section-2-title>Arquitectura técnica y patrones de ingeniería</h2>
      <p data-section-2-intro>
        El sistema está estructurado mediante el patrón <strong>Modelo-Vista-Controlador (MVC)</strong> en PHP, garantizando una separación clara entre la lógica de negocio, el almacenamiento y la presentación visual:
      </p>

      <div class="arch-cards-grid">
        <div class="arch-card">
          <div class="arch-header">
            <span class="arch-icon">⚡</span>
            <h4>Controladores POO (PHP 8)</h4>
          </div>
          <ul class="bullet-list">
            <li><strong>EventController & UserController:</strong> Clases desacopladas encargadas de coordinar la lógica de negocio y las peticiones POST/GET.</li>
            <li><strong>Validación & Sanitización:</strong> Verificación estricta de parámetros obligatorios, tipos y subida controlada de imágenes de portada.</li>
            <li><strong>Manejo de Sesiones:</strong> Control de autenticación nativo en PHP con <code>$_SESSION</code> para protección de rutas según rol.</li>
            <li><strong>Seguridad de Acceso:</strong> Almacenamiento seguro de contraseñas mediante algoritmos de hashing <code>password_hash()</code>.</li>
          </ul>
        </div>

        <div class="arch-card">
          <div class="arch-header">
            <span class="arch-icon">💾</span>
            <h4>Persistencia & Base de Datos (MySQL / MariaDB)</h4>
          </div>
          <ul class="bullet-list">
            <li><strong>Abstracción PDO:</strong> Conexión mediante PHP Data Objects con prepared statements para prevenir inyecciones SQL.</li>
            <li><strong>Integridad Referencial:</strong> Relaciones relacionales entre <code>usuarios</code>, <code>eventos</code> e <code>inscripciones</code> con cascada (<code>ON DELETE CASCADE</code>).</li>
            <li><strong>Tipos Normalizados:</strong> Enums para deportes y roles, control temporal de fecha y hora, y almacenamiento de ubicaciones con código postal.</li>
            <li><strong>Indexación & Consultas:</strong> Filtrado por disciplina deportiva y ordenación cronológica descendente.</li>
          </ul>
        </div>

        <div class="arch-card">
          <div class="arch-header">
            <span class="arch-icon">🎨</span>
            <h4>Vistas & Experiencia de Usuario</h4>
          </div>
          <ul class="bullet-list">
            <li><strong>Modularidad de Vistas:</strong> Pantallas especializadas con hojas de estilos CSS dedicadas por módulo funcional.</li>
            <li><strong>Filtros Reactivos en Cliente:</strong> Búsqueda en tiempo real mediante JavaScript/jQuery sin recargas innecesarias.</li>
            <li><strong>Diseño Responsive:</strong> Rejilla adaptable para pantallas móviles y escritorios optimizada para consulta rápida en pistas.</li>
            <li><strong>Integración con Mapas:</strong> Enlaces directos a Google Maps para facilitar la llegada de los deportistas a cada sede.</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- Source Code & Repository -->
    <section class="project-panel">
      <h2 data-section-3-title>Repositorio y código fuente</h2>
      <p data-section-3-intro>El repositorio completo del proyecto está disponible de forma abierta en GitHub:</p>
      <div class="code-terminal">
        <div class="terminal-bar">
          <span class="dot red"></span>
          <span class="dot yellow"></span>
          <span class="dot green"></span>
          <span class="terminal-title">bash · repository ProjectEventSportsBCN</span>
        </div>
        <pre><code data-terminal-code># Clonar repositorio
git clone https://github.com/alexBarrera457/ProjectEventSportsBCN.git
cd ProjectEventSportsBCN

# Importar el esquema de base de datos en MySQL
mysql -u root -p eventsportsbcn &lt; Model/Model.sql

# Iniciar Apache y MySQL en XAMPP y acceder desde el navegador:
# http://localhost/ProjectEventSportsBCN/View/HTML/Pages/HomeMenu.php</code></pre>
      </div>
      <div class="action-buttons-row">
        <a class="button primary" href="https://github.com/alexBarrera457/ProjectEventSportsBCN" target="_blank" rel="noopener noreferrer" data-repo-btn>
          Ver repositorio en GitHub ↗
        </a>
        <a class="button" href="/#contact" data-contact-btn>
          Contactar conmigo →
        </a>
      </div>
    </section>

    <!-- Conclusion Panel -->
    <section class="project-panel conclusion-panel">
      <h2 data-section-4-title>Conclusión y balance profesional</h2>
      <p data-section-4-text>
        EventSportsBCN representa la consolidación de los fundamentos del desarrollo web del lado del servidor: estructurar una aplicación completa desde la arquitectura MVC, el diseño del esquema relacional en SQL, la gestión de sesiones seguras y la entrega de una interfaz visual clara para deportistas y gestores de la ciudad de Barcelona.
      </p>
      <div class="conclusion-actions">
        <a class="button primary" href="/#projects" data-cta-btn>
          Ver otros proyectos del portfolio ↗
        </a>
        <a class="button" href="/" data-footer-back>
          ← Volver al inicio
        </a>
      </div>
    </section>
  </main>

