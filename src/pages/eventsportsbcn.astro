    /* Views Grid */
    .views-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 1.6rem;
      margin-top: 2rem;
    }

    .view-card {
      border: 1px solid var(--line);
      border-radius: 12px;
      background: #ffffff;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      box-shadow: 0 4px 14px rgba(19, 34, 56, 0.04);
      transition: transform 0.25s ease, box-shadow 0.25s ease;
