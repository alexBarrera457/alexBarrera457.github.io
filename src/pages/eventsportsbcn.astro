    .view-info h4 {
      font: 600 1.05rem var(--sans);
      color: var(--ink);
      margin: 0;
    }

    .view-info p {
      font-size: 0.88rem;
      line-height: 1.5;
      color: var(--muted);
      margin: 0;
    }

    /* Metrics Grid */
    .metrics-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
      gap: 1.2rem;
    }

    .metric-card {
      padding: 1.8rem;
