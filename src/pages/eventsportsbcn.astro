      font-size: 1.3rem;
    }

    .arch-header h4 {
      font: 600 1.05rem var(--sans);
      color: var(--ink);
      margin: 0;
    }

    /* Code Terminal */
    .code-terminal {
      margin-top: 1.4rem;
      border-radius: 12px;
      overflow: hidden;
      background: #111827;
      border: 1px solid #1f2937;
      box-shadow: 0 12px 28px rgba(0, 0, 0, 0.2);
    }

    .terminal-bar {
      display: flex;
      align-items: center;
