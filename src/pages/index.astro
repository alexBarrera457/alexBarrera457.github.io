        en: { repository: 'Repository', updated: 'Updated', view: 'View repository ↗', empty: 'GitHub activity could not be loaded.' }
      };
      const renderGithubRepositories = (language: Language) => {
        const container = document.querySelector<HTMLElement>('[data-github-repositories]');
        if (!container) return;
        const labels = githubLabels[language];
        container.replaceChildren();
        if (!githubRepositories.length) {
          const empty = document.createElement('article');
          empty.className = 'github-repository github-loading';
          empty.textContent = labels.empty;
          container.append(empty);
          return;
        }
        githubRepositories.forEach((repository) => {
          const card = document.createElement('article');
          card.className = 'github-repository';
          const label = document.createElement('span');
          label.className = 'github-repository-label';
          label.textContent = labels.repository;
          const title = document.createElement('h3');
          title.textContent = repository.name;
          const description = document.createElement('p');
          description.textContent = repository.description || '';
          const meta = document.createElement('div');
          meta.className = 'github-repository-meta';
          meta.textContent = `${repository.language || 'Web'} · ${labels.updated} ${new Date(repository.updated_at).toLocaleDateString(language === 'en' ? 'en-GB' : language === 'ca' ? 'ca-ES' : 'es-ES')}`;
          const link = document.createElement('a');
          link.className = 'button';
