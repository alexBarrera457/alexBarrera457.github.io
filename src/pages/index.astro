        document.querySelectorAll('.project-eventsports .feature-list li').forEach((item, index) => { item.textContent = detail.eventFeatures[index]; });
        document.querySelectorAll('.project-calsarda .feature-list li').forEach((item, index) => { item.textContent = detail.calsardaFeatures[index]; });
        document.querySelectorAll('.project-secondary .feature-list li').forEach((item, index) => { item.textContent = detail.nexusFeatures[index]; });
        const eventInfoBtn = document.querySelector<HTMLElement>('[data-eventsports-info-btn]');
        if (eventInfoBtn) eventInfoBtn.textContent = detail.eventInfoBtn;
        const eventGithubBtn = document.querySelector<HTMLElement>('[data-eventsports-github-btn]');
        if (eventGithubBtn) eventGithubBtn.textContent = detail.eventGithubBtn;
        const calsardaInfoBtn = document.querySelector<HTMLElement>('[data-calsarda-info-btn]');
        if (calsardaInfoBtn) calsardaInfoBtn.textContent = detail.calsardaInfoBtn;
        const calsardaGithubBtn = document.querySelector<HTMLElement>('[data-calsarda-github-btn]');
        if (calsardaGithubBtn) calsardaGithubBtn.textContent = detail.calsardaGithubBtn;
        const nexusBtn = document.querySelector<HTMLElement>('[data-nexus-info-btn]');
        if (nexusBtn) nexusBtn.textContent = detail.nexusButton;
        const nexusGithubBtn = document.querySelector<HTMLElement>('[data-nexus-github-btn]');
        if (nexusGithubBtn) nexusGithubBtn.textContent = detail.nexusGithubBtn;

        const expIntroEl = document.querySelector<HTMLElement>('[data-experience-intro]');
        if (expIntroEl) expIntroEl.textContent = detail.expIntro;
        const expAltiaRoleEl = document.querySelector<HTMLElement>('[data-exp-altia-role]');
        if (expAltiaRoleEl) expAltiaRoleEl.textContent = detail.expAltiaRole;
        const expAltiaBadgeEl = document.querySelector<HTMLElement>('[data-exp-altia-badge]');
        if (expAltiaBadgeEl) expAltiaBadgeEl.textContent = detail.expAltiaBadge;
        const expAltiaDescEl = document.querySelector<HTMLElement>('[data-exp-altia-desc]');
        if (expAltiaDescEl) expAltiaDescEl.textContent = detail.expAltiaDesc;

        const expCanguroRoleEl = document.querySelector<HTMLElement>('[data-exp-canguro-role]');
        if (expCanguroRoleEl) expCanguroRoleEl.textContent = detail.expCanguroRole;
        const expCanguroBadgeEl = document.querySelector<HTMLElement>('[data-exp-canguro-badge]');
        if (expCanguroBadgeEl) expCanguroBadgeEl.textContent = detail.expCanguroBadge;
        const expCanguroDescEl = document.querySelector<HTMLElement>('[data-exp-canguro-desc]');
        if (expCanguroDescEl) expCanguroDescEl.textContent = detail.expCanguroDesc;

        const expSardaRoleEl = document.querySelector<HTMLElement>('[data-exp-sarda-role]');
        if (expSardaRoleEl) expSardaRoleEl.textContent = detail.expSardaRole;
        const expSardaBadgeEl = document.querySelector<HTMLElement>('[data-exp-sarda-badge]');
        if (expSardaBadgeEl) expSardaBadgeEl.textContent = detail.expSardaBadge;
        const expSardaDescEl = document.querySelector<HTMLElement>('[data-exp-sarda-desc]');
        if (expSardaDescEl) expSardaDescEl.textContent = detail.expSardaDesc;

        const activityLabelEl = document.querySelector<HTMLElement>('[data-activity-label]');
        if (activityLabelEl) activityLabelEl.textContent = detail.activityLabel;
        const githubIntroPEl = document.querySelector<HTMLElement>('[data-github-intro-p]');
        if (githubIntroPEl) githubIntroPEl.textContent = detail.githubIntroP;
        const filterLabels = {
          es: { all: 'Todos', frontend: 'Frontend', backend: 'Backend', database: 'Bases de datos', tools: 'Herramientas' },
          ca: { all: 'Tots', frontend: 'Frontend', backend: 'Backend', database: 'Bases de dades', tools: 'Eines' },
          en: { all: 'All', frontend: 'Frontend', backend: 'Backend', database: 'Databases', tools: 'Tools' }
        };
        document.querySelectorAll<HTMLElement>('[data-filter-key]').forEach((el) => {
          const key = el.dataset.filterKey as keyof typeof filterLabels.es;
          if (key && filterLabels[language][key]) {
            el.textContent = filterLabels[language][key];
          }
        });
        document.querySelectorAll('.info-row').forEach((row, index) => { row.querySelector('span:first-child')!.textContent = detail.infoLabels[index]; const value = row.querySelector('span:last-child, a'); if (value) value.textContent = detail.infoValues[index]; });
        document.querySelectorAll('.cv-highlights article .cv-highlight-label, .cv-highlights article h3, .cv-highlights article p').forEach((element, index) => { if (detail.highlights[index]) element.textContent = detail.highlights[index]; });
        document.querySelector('.nexus-kicker')!.textContent = detail.nexusKicker;
        document.querySelector('.nexus-title-block h4')!.innerHTML = detail.nexusTitle;
        document.querySelectorAll('.nexus-row span').forEach((item, index) => { item.textContent = detail.nexusPills[index]; });
        document.querySelectorAll('.project-eventsports .project-tags .project-tag').forEach((el, index) => { if (detail.eventTags[index]) el.textContent = detail.eventTags[index]; });
        document.querySelectorAll('.project-calsarda .project-tags .project-tag').forEach((el, index) => { if (detail.calsardaTags[index]) el.textContent = detail.calsardaTags[index]; });
        document.querySelectorAll('.project-secondary .project-tags .project-tag').forEach((el, index) => { if (detail.nexusTags[index]) el.textContent = detail.nexusTags[index]; });
        const githubLoading = document.querySelector('[data-github-repositories] .github-loading');
        if (githubLoading) githubLoading.textContent = copy.loadingGithub;
        renderGithubRepositories(language);
        const copyLabel = language === 'en' ? 'Copy email' : language === 'ca' ? 'Copiar correu' : 'Copiar email';
        const copyTitle = language === 'en' ? 'Copy email to clipboard' : language === 'ca' ? 'Copiar correu al porta-retalls' : 'Copiar correo al portapapeles';
        document.querySelectorAll('.copy-email-btn .copy-text').forEach((el) => { el.textContent = copyLabel; });
        document.querySelectorAll<HTMLElement>('.copy-email-btn').forEach((el) => { el.setAttribute('title', copyTitle); });
        const toastMsg = document.getElementById('copy-toast-msg');
        if (toastMsg) toastMsg.textContent = language === 'en' ? 'Email copied to clipboard' : language === 'ca' ? 'Correu copiat al porta-retalls' : 'Email copiado al portapapeles';
        
        const smartMailto = getMailtoUrl(language);
        document.querySelectorAll<HTMLAnchorElement>('[data-contact-mail], [data-info-mail]').forEach((a) => {
          a.href = smartMailto;
        });

        document.documentElement.lang = language;
        document.querySelectorAll('[data-language]').forEach((button) => button.setAttribute('aria-pressed', String(button.getAttribute('data-language') === language)));
        localStorage.setItem('portfolio-language', language);
      };

      const mailtoTemplates: Record<Language, { subject: string; body: string }> = {
        es: {
          subject: 'Contacto profesional — Àlex Barrera',
          body: 'Hola Àlex,\n\nHe visto tu portfolio y me gustaría contactar contigo sobre...\n\nUn saludo,'
        },
        ca: {
          subject: 'Contacte professional — Àlex Barrera',
          body: 'Hola Àlex,\n\nHe vist el teu portfoli i m’agradaria contactar amb tu sobre...\n\nUna salutació,'
        },
        en: {
          subject: 'Professional Opportunity — Àlex Barrera',
          body: 'Hi Àlex,\n\nI reviewed your portfolio and would like to get in touch regarding...\n\nBest regards,'
        }
      };

      const getMailtoUrl = (lang: Language) => {
        const t = mailtoTemplates[lang] || mailtoTemplates.es;
        return `mailto:salexbarrera@gmail.com?subject=${encodeURIComponent(t.subject)}&body=${encodeURIComponent(t.body)}`;
      };

      const getLanguage = (value: string | null): Language => {
        if (value === 'ca' || value === 'en' || value === 'es') return value;
        const nav = (typeof navigator !== 'undefined' ? (navigator.language || (navigator as any).userLanguage || '') : '').toLowerCase();
        if (nav.startsWith('ca')) return 'ca';
        if (nav.startsWith('en')) return 'en';
        return 'es';
      };

      const initialDataEl = document.getElementById('github-initial-data');
      if (initialDataEl?.textContent) {
        try {
          githubRepositories = JSON.parse(initialDataEl.textContent);
        } catch {}
      }
      document.querySelectorAll<HTMLButtonElement>('[data-language]').forEach((button) => button.addEventListener('click', () => setLanguage(getLanguage(button.dataset.language || null))));
      setLanguage(getLanguage(localStorage.getItem('portfolio-language')));

      fetch('https://api.github.com/users/alexBarrera457/repos?sort=updated&per_page=8')
        .then((response) => response.ok ? response.json() as Promise<GithubRepository[]> : Promise.reject(new Error('GitHub request failed')))
        .then((repositories) => {
          const fresh = repositories.filter((repository) => !repository.fork).slice(0, 4);
          if (fresh.length) {
            githubRepositories = fresh;
            renderGithubRepositories(getLanguage(localStorage.getItem('portfolio-language')));
          }
        })
        .catch(() => renderGithubRepositories(getLanguage(localStorage.getItem('portfolio-language'))));

      const header = document.querySelector('[data-header]');
      const revealItems = document.querySelectorAll('.reveal');
      const sections = document.querySelectorAll('main section[id]');
      const navLinks = document.querySelectorAll('.nav-links a');
      const menuToggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
      const nav = document.querySelector<HTMLElement>('.nav');
      const progress = document.querySelector<HTMLElement>('[data-progress]');
      menuToggle?.addEventListener('click', () => {
        const isOpen = nav?.classList.toggle('menu-open') ?? false;
        menuToggle.setAttribute('aria-expanded', String(isOpen));
        const icon = menuToggle.querySelector('span');
        if (icon) icon.textContent = isOpen ? '×' : '+';
      });
      navLinks.forEach((link) => link.addEventListener('click', () => {
        nav?.classList.remove('menu-open');
        menuToggle?.setAttribute('aria-expanded', 'false');
        const icon = menuToggle?.querySelector('span');
        if (icon) icon.textContent = '+';
      }));
      const profilePhoto = document.querySelector<HTMLImageElement>('.profile-photo');
      const profileFallback = document.querySelector<HTMLElement>('.profile-fallback');

      const showProfileFallback = () => {
        if (profilePhoto) profilePhoto.style.display = 'none';
        if (profileFallback) profileFallback.style.display = 'grid';
      };
      if (profilePhoto && profileFallback) {
        profilePhoto.addEventListener('load', () => {
          profileFallback.style.display = 'none';
          profilePhoto.style.display = 'block';
        });
        profilePhoto.addEventListener('error', showProfileFallback);
        if (profilePhoto.complete && profilePhoto.naturalWidth === 0) showProfileFallback();
      }

      document.querySelectorAll<HTMLElement>('.project').forEach((card) => {
        const photo = card.querySelector<HTMLImageElement>('.project-photo');
        const screen = card.querySelector<HTMLElement>('.project-screen');
        if (photo && screen) {
          const showPhoto = () => {
            photo.style.opacity = '1';
            screen.style.display = 'none';
          };
          photo.addEventListener('load', showPhoto);
          photo.addEventListener('error', () => {
            photo.style.display = 'none';
          });
          if (photo.complete && photo.naturalWidth > 0) showPhoto();
        }
      });

      document.querySelectorAll<HTMLButtonElement>('.copy-email-btn').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const email = btn.getAttribute('data-copy-email') || 'salexbarrera@gmail.com';
          const copyText = btn.querySelector('.copy-text');
          const copyIcon = btn.querySelector('.copy-icon');
          const currentLang = getLanguage(localStorage.getItem('portfolio-language'));
          const copiedLabel = currentLang === 'en' ? 'Copied!' : currentLang === 'ca' ? 'Copiat!' : '¡Copiado!';
          const originalLabel = currentLang === 'en' ? 'Copy email' : currentLang === 'ca' ? 'Copiar correu' : 'Copiar email';
          try {
            await navigator.clipboard.writeText(email);
            if (copyText) copyText.textContent = copiedLabel;
            if (copyIcon) copyIcon.textContent = '✓';
            btn.classList.add('copied');
            const toast = document.getElementById('copy-toast');
            if (toast) toast.classList.add('show');
            setTimeout(() => {
              if (copyText) copyText.textContent = originalLabel;
              if (copyIcon) copyIcon.textContent = '📋';
              btn.classList.remove('copied');
              if (toast) toast.classList.remove('show');
            }, 2200);
          } catch {
            window.location.href = getMailtoUrl(getLanguage(localStorage.getItem('portfolio-language')));
          }
        });
      });

      const filterButtons = document.querySelectorAll<HTMLButtonElement>('.skill-filter-btn');
      const skillsContainer = document.querySelector<HTMLElement>('.skills');
      const skillCards = document.querySelectorAll<HTMLElement>('.skill');

      filterButtons.forEach((btn) => {
        btn.addEventListener('click', () => {
          const filter = btn.dataset.filter || 'all';
          filterButtons.forEach((b) => {
            const isActive = b === btn;
            b.classList.toggle('is-active', isActive);
            b.setAttribute('aria-selected', String(isActive));
          });
          if (skillsContainer) {
            skillsContainer.classList.toggle('is-filtered', filter !== 'all');
          }
          skillCards.forEach((card) => {
            const category = card.dataset.category;
            const matches = filter === 'all' || category === filter;
            card.classList.toggle('is-hidden', !matches);
          });
        });
      });

      window.addEventListener('scroll', () => {
        header?.classList.toggle('scrolled', window.scrollY > 20);
        const scrollableHeight = document.documentElement.scrollHeight - window.innerHeight;
        if (progress && scrollableHeight > 0) progress.style.transform = `scaleX(${window.scrollY / scrollableHeight})`;
      }, { passive: true });

      const revealObserver = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('visible');
            revealObserver.unobserve(entry.target);
          }
        });
      }, { threshold: 0.12 });
      revealItems.forEach((item) => revealObserver.observe(item));

      const navObserver = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          navLinks.forEach((link) => link.classList.toggle('active', link.getAttribute('href') === `#${entry.target.id}`));
        });
      }, { rootMargin: '-35% 0px -55%' });
      sections.forEach((section) => navObserver.observe(section));
    </script>
</BaseLayout>
