---
import BaseLayout from '../layouts/BaseLayout.astro';
import LanguageSwitcher from '../components/LanguageSwitcher.astro';

const skills = [
  ['/icons/java.svg', 'Java', 'backend', 'backend'],
  ['/icons/php.svg', 'PHP', 'backend', 'backend'],
  ['/icons/symfony.svg', 'Symfony', 'framework', 'backend'],
  ['/icons/laravel.svg', 'Laravel', 'framework', 'backend'],
  ['/icons/javascript.svg', 'JavaScript', 'frontend', 'frontend'],
  ['/icons/react.svg', 'React', 'frontend', 'frontend'],
  ['/icons/angular.svg', 'Angular', 'frontend', 'frontend'],
  ['/icons/html5.svg', 'HTML5', 'frontend', 'frontend'],
  ['/icons/css3.svg', 'CSS3', 'frontend', 'frontend'],
  ['/icons/mysql.svg', 'MySQL', 'database', 'database'],
  ['/icons/mongodb.svg', 'MongoDB', 'database', 'database'],
  ['/icons/git.svg', 'Git', 'tooling', 'tools'],
  ['/icons/github.svg', 'GitHub', 'tooling', 'tools'],
  ['/icons/vscode.svg', 'VS Code', 'tooling', 'tools'],
  ['/icons/netbeans.svg', 'NetBeans', 'IDE', 'tools']
];

const marqueeItems = ['Java', 'PHP', 'Symfony', 'Laravel', 'React', 'Angular', 'MySQL', 'Git'];

const defaultRepos = [
  {
    name: 'Prototipo-Cal-Sard-',
    html_url: 'https://github.com/alexBarrera457/Prototipo-Cal-Sard-',
    description: 'Prototipo de tienda real para el comercio tradicional y charcutería centenaria Cal Sardà con Angular 22 y SSR.',
    language: 'TypeScript',
    updated_at: '2026-10-05T17:27:17Z'
  },
  {
    name: 'alexBarrera457.github.io',
    html_url: 'https://github.com/alexBarrera457/alexBarrera457.github.io',
    description: 'Portfolio personal y profesional desarrollado con Astro, TypeScript y diseño moderno adaptativo.',
    language: 'Astro',
    updated_at: '2026-10-06T20:25:34Z'
  },
  {
    name: 'MP0613_RA3_POO_Bank',
    html_url: 'https://github.com/alexBarrera457/MP0613_RA3_POO_Bank',
    description: 'Práctica académica de Programación Orientada a Objetos en PHP simulando operaciones bancarias.',
    language: 'PHP',
    updated_at: '2026-10-06T15:45:00Z'
  },
  {
    name: 'OmniNexus',
    html_url: 'https://github.com/alexBarrera457/OmniNexus',
    description: 'Interfaz experimental de chat inteligente con backend Express, SQLite y enrutamiento de herramientas.',
    language: 'JavaScript',
    updated_at: '2026-09-24T16:03:07Z'
  }
];

let buildRepos = defaultRepos;
try {
  const res = await fetch('https://api.github.com/users/alexBarrera457/repos?sort=updated&per_page=8', {
    headers: { 'User-Agent': 'Portfolio-Build' }
  });
  if (res.ok) {
    const raw = (await res.json()) as Array<{ name: string; html_url: string; description: string | null; language: string | null; updated_at: string; fork: boolean }>;
    const filtered = raw.filter((r) => !r.fork).slice(0, 4);
    if (filtered.length) {
      buildRepos = filtered.map((r) => ({
        name: r.name,
        html_url: r.html_url,
        description: r.description || 'Repositorio público de desarrollo web.',
        language: r.language || 'Web',
        updated_at: r.updated_at
      }));
    }
  }
} catch {
  // Use curated defaultRepos fallback
}
---

<BaseLayout
  title="Àlex Barrera — Desarrollador web"
  description="Portfolio de Àlex Barrera Sardà, estudiante de segundo de DAW y desarrollador de aplicaciones web en Barcelona."
  ogImage="https://alexbarrera457.github.io/images/profile.jpg"
  canonicalUrl="https://alexbarrera457.github.io/"
>
  <a class="skip-link" href="#main-content">Saltar al contenido</a>
  <header class="site-header" data-header>
    <nav class="nav" aria-label="Navegación principal">
      <a class="logo" href="#hero">Àlex<span>.</span>Barrera</a>
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="main-menu">Menú <span>+</span></button>
      <ul class="nav-links" id="main-menu">
        <li><a href="#stack">Stack</a></li>
        <li><a href="#projects">Proyectos</a></li>
        <li><a href="#experience">Experiencia</a></li>
        <li><a href="#about">Sobre mí</a></li>
        <li><a href="#contact">Contacto</a></li>
      </ul>
      <LanguageSwitcher />
    </nav>
    <div class="scroll-progress" data-progress></div>
  </header>

    <main id="main-content">
      <section class="hero" id="hero">
        <div class="container hero-grid">
          <div>
            <p class="eyebrow">2º DAW · Stucom Barcelona · 2026</p>
            <h1>Ideas que se vuelven <em>interfaz.</em></h1>
            <p class="hero-copy">Soy Àlex, estudiante de DAW y desarrollador web en formación. Me interesa crear productos digitales funcionales, bien diseñados y pensados para resolver problemas reales con una base técnica sólida.</p>
            <div class="actions">
              <a class="button primary" href="#projects">Ver mi trabajo <span>↗</span></a>
              <a class="button" href="/cv" target="_blank" rel="noopener noreferrer">Ver currículum <span>↗</span></a>
              <a class="button" href="https://www.linkedin.com/in/%C3%A0lex-barrera-sard%C3%A0-35b088397/" target="_blank" rel="noopener noreferrer">LinkedIn <span>↗</span></a>
              <button type="button" class="button copy-email-btn" data-copy-email="salexbarrera@gmail.com" title="Copiar correo al portapapeles">
                <span class="copy-text">Copiar email</span> <span class="copy-icon">📋</span>
              </button>
            </div>
          </div>

          <div class="hero-art" aria-label="Foto de perfil de Àlex Barrera">
            <div class="orbit"></div>
            <div class="profile-shape"></div>
            <div class="profile-photo-wrap">
              <img class="profile-photo" src="/images/profile.jpg" alt="Foto de perfil de Àlex Barrera" width="400" height="400" fetchpriority="high" decoding="async" />
              <span class="profile-fallback">AB</span>
            </div>
            <div class="art-note"><strong>Disponible</strong>para nuevas oportunidades</div>
          </div>
        </div>
      </section>

      <div class="marquee" aria-label="Tecnologías utilizadas">
        <div class="marquee-track">
          {[0, 1].map((group) => (
            <div class="marquee-group" aria-hidden={group === 1}>
              {marqueeItems.map((item) => <><span>{item}</span><i></i></>)}
            </div>
          ))}
        </div>
      </div>

      <section class="section" id="stack">
        <div class="container">
          <div class="section-heading reveal"><span class="number">01</span><h2>Mi caja de herramientas</h2></div>
          <p class="section-intro reveal">Tecnologías que uso para pensar, construir y llevar una idea desde la base de datos hasta el navegador.</p>
          <div class="skills-filter reveal" role="tablist" aria-label="Filtrar tecnologías">
            <button type="button" class="skill-filter-btn is-active" data-filter="all" role="tab" aria-selected="true">
              <span class="filter-label" data-filter-key="all">Todos</span> <span class="filter-count">15</span>
            </button>
            <button type="button" class="skill-filter-btn" data-filter="frontend" role="tab" aria-selected="false">
              <span class="filter-label" data-filter-key="frontend">Frontend</span> <span class="filter-count">5</span>
            </button>
            <button type="button" class="skill-filter-btn" data-filter="backend" role="tab" aria-selected="false">
              <span class="filter-label" data-filter-key="backend">Backend</span> <span class="filter-count">4</span>
            </button>
            <button type="button" class="skill-filter-btn" data-filter="database" role="tab" aria-selected="false">
              <span class="filter-label" data-filter-key="database">Bases de datos</span> <span class="filter-count">2</span>
            </button>
            <button type="button" class="skill-filter-btn" data-filter="tools" role="tab" aria-selected="false">
              <span class="filter-label" data-filter-key="tools">Herramientas</span> <span class="filter-count">4</span>
            </button>
          </div>
          <div class="skills reveal">
            {skills.map(([icon, name, type, category]) => (
              <article class="skill" data-category={category}>
                <span class="skill-icon" aria-hidden="true">
                  <img src={icon} alt="" width="34" height="34" loading="lazy" />
                </span>
                <strong class="skill-name">{name}</strong>
                <span class="skill-type">{type}</span>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="section" id="projects">
        <div class="container">
          <div class="section-heading reveal"><span class="number">02</span><h2>Proyectos en curso</h2></div>

          <article class="project project-eventsports reveal">
            <div class="project-copy">
              <span class="project-label">Featured build · 2026</span>
              <h3>EventSportsBCN</h3>
              <p>Una plataforma full-stack para descubrir y gestionar eventos deportivos en Barcelona, construida con arquitectura MVC y roles de usuario diferenciados.</p>
              <div class="project-tags">
                <span class="project-tag">PHP</span>
                <span class="project-tag">MySQL</span>
                <span class="project-tag">JavaScript</span>
                <span class="project-tag">Arquitectura MVC</span>
                <span class="project-tag">Responsive</span>
              </div>
              <ul class="feature-list">
                <li>Autenticación para usuarios y gestores.</li>
                <li>Control de aforo e inscripciones.</li>
                <li>Panel de administración de eventos.</li>
                <li>MySQL, PHP, JavaScript y diseño responsive.</li>
              </ul>
              <div class="actions">
                <a class="button primary" href="/eventsportsbcn" data-eventsports-info-btn>Más información ↗</a>
                <a class="button" href="https://github.com/alexBarrera457/ProjectEventSportsBCN" target="_blank" rel="noopener noreferrer" data-eventsports-github-btn>Ver en GitHub ↗</a>
              </div>
            </div>
            <div class="project-visual">
              <img class="project-photo" src="/images/eventsportsbcn.jpg" alt="EventSportsBCN, plataforma de eventos deportivos" width="600" height="380" loading="lazy" decoding="async" />
              <div class="project-screen" aria-hidden="true">
                <div class="screen-bar"><i></i><i></i><i></i></div>
                <div class="screen-title">Events<span style="color:var(--coral-dark)">BCN</span></div>
                <div class="screen-line"></div><div class="screen-line short"></div>
                <div class="screen-pills"><i></i><i></i><i></i></div>
              </div>
            </div>
          </article>

          <article class="project project-calsarda reveal" style="margin-top: 2rem;">
            <div class="project-copy">
              <span class="project-label">Proyecto personal · 2026</span>
              <h3>Cal Sardà</h3>
              <p>Prototipo de tienda real para el comercio tradicional y charcutería centenaria Cal Sardà (fundado en 1930). Desarrollado como proyecto personal para digitalizar la experiencia de compra: catálogo interactivo de productos gourmet, alérgenos, gestión de cestas y pedidos de recogida y entrega.</p>
              <div class="project-tags">
                <span class="project-tag">Angular 22</span>
                <span class="project-tag">SSR / Express</span>
                <span class="project-tag">TypeScript</span>
                <span class="project-tag">Domain-Driven</span>
                <span class="project-tag">E-Commerce</span>
              </div>
              <ul class="feature-list">
                <li>Desarrollado con Angular 22, SSR y arquitectura modular orientada al dominio.</li>
                <li>Catálogo gastronómico interactivo con filtros, categorías y control de alérgenos.</li>
                <li>Gestión de cesta de compra y flujo de pedidos para recogida en tienda o envío.</li>
                <li>Modelado riguroso de entidades (obrador, lotes, productos y pedidos).</li>
              </ul>
              <div class="actions">
                <a class="button primary" href="/cal-sarda" data-calsarda-info-btn>Más información ↗</a>
                <a class="button" href="https://github.com/alexBarrera457/Prototipo-Cal-Sard-" target="_blank" rel="noopener noreferrer" data-calsarda-github-btn>Ver en GitHub ↗</a>
              </div>
            </div>
            <div class="project-visual project-visual-calsarda">
              <img class="project-photo" src="/images/calsarda.jpg" alt="Cal Sardà, prototipo de tienda real" width="600" height="380" loading="lazy" decoding="async" />
              <div class="project-screen project-screen-calsarda" aria-hidden="true">
                <div class="screen-bar"><i></i><i></i><i></i></div>
                <div class="screen-title">Cal <span style="color:var(--coral)">Sardà</span></div>
                <div class="screen-line"></div><div class="screen-line short"></div>
                <div class="screen-pills"><i></i><i></i><i></i></div>
              </div>
            </div>
          </article>

          <article class="project project-secondary reveal" style="margin-top: 2rem; border: 1px solid rgba(255,255,255,.18); box-shadow: 0 22px 40px rgba(19,34,56,.18);">
            <div class="project-copy">
              <span class="project-label">En curso · 2026</span>
              <h3>OMNI // NEXUS</h3>
              <p>Proyecto experimental de chat inteligente local que combina una interfaz web con historial de conversaciones, memoria opcional y herramientas de búsqueda, cálculo y respuesta contextual. Está en desarrollo y me permite explorar la integración entre IA, backend y experiencia de usuario.</p>
              <div class="project-tags">
                <span class="project-tag">Node.js</span>
                <span class="project-tag">Express</span>
                <span class="project-tag">SQLite</span>
                <span class="project-tag">REST API</span>
                <span class="project-tag">IA Local / OpenAI API</span>
              </div>
              <ul class="feature-list">
                <li>Backend Express con API REST y SQLite.</li>
                <li>Diseño visual de panel de control y feedback de estado.</li>
                <li>Integración con proveedores compatibles con OpenAI.</li>
                <li>Desarrollo continuo con IA, lógica propia y enfoque práctico.</li>
              </ul>
              <div class="actions">
                <a class="button primary" href="/omni-nexus" data-nexus-info-btn>Más información ↗</a>
              </div>
            </div>
            <div class="project-visual project-visual-secondary nexus-preview" aria-label="Previsualización de la interfaz OMNI // NEXUS">
              <div class="nexus-ui">
                <div class="nexus-topbar">
                  <span class="nexus-brand">NEXUS</span>
                  <span class="nexus-status">online</span>
                </div>
                <div class="nexus-mainline"></div>
                <div class="nexus-title-block">
                  <span class="nexus-kicker">YOUR LOCAL INTELLIGENCE LAYER</span>
                  <h4>Think in <em>systems.</em></h4>
                </div>
                <div class="nexus-row">
                  <span>WEB SEARCH</span>
                  <span>MEMORY</span>
                  <span>CALCULATOR</span>
                </div>
              </div>
            </div>
          </article>
        </div>
      </section>

      <section class="section github-section" id="experience">
        <div class="container">
          <div class="section-heading reveal"><span class="number">03</span><h2>Experiencia y actividad</h2></div>
          <div class="github-intro reveal">
            <p>Una selección de mi actividad pública en GitHub: proyectos, tecnologías y trabajo reciente.</p>
            <a class="button" href="https://github.com/alexBarrera457" target="_blank" rel="noopener noreferrer">Ver perfil en GitHub ↗</a>
          </div>
          <div class="github-repositories reveal" data-github-repositories>
            {buildRepos.map((repo) => (
              <article class="github-repository">
                <span class="github-repository-label">Repositorio</span>
                <h3>{repo.name}</h3>
                <p>{repo.description}</p>
                <div class="github-repository-meta">
                  {repo.language} · Actualizado {new Date(repo.updated_at).toLocaleDateString('es-ES')}
                </div>
                <a class="button" href={repo.html_url} target="_blank" rel="noopener noreferrer">Ver repositorio ↗</a>
              </article>
            ))}
          </div>
          <script id="github-initial-data" type="application/json" set:html={JSON.stringify(buildRepos)} />
        </div>
      </section>

      <section class="section" id="about">
        <div class="container">
          <div class="section-heading reveal"><span class="number">04</span><h2>Un poco sobre mí</h2></div>
          <div class="about-grid reveal">
            <div class="about-copy">
              <p>Estoy cursando <strong>Desarrollo de Aplicaciones Web</strong> en Stucom Barcelona y me apasiona construir soluciones completas, desde la lógica de negocio hasta la experiencia final del usuario.</p>
              <p>He trabajado con <strong>Java, PHP, Symfony, Laravel, React, Angular, SQL, MongoDB y VS Code</strong>, además de diseño responsive, gestión de bases de datos y resolución de problemas en proyectos web reales.</p>
              <p>Actualmente estoy buscando una oportunidad de <strong>prácticas</strong> para seguir creciendo como desarrollador, aportar valor en un equipo y aprender de proyectos profesionales reales.</p>
            </div>
            <div class="info-card">
              <div class="info-row"><span>Ubicación</span><span>Barcelona, España</span></div>
              <div class="info-row"><span>Estudios</span><span>DAW · Stucom · 2º</span></div>
              <div class="info-row"><span>Enfoque</span><span>Full-stack web</span></div>
              <div class="info-row"><span>Estado</span><span class="status">Buscando prácticas</span></div>
              <div class="info-row"><span>Idiomas</span><span>Catalán C1 · Castellano · Inglés B1</span></div>
              <div class="info-row"><span>Email</span><span>salexbarrera@gmail.com</span></div>
              <div class="info-row"><span>LinkedIn</span><a href="https://www.linkedin.com/in/%C3%A0lex-barrera-sard%C3%A0-35b088397/" target="_blank" rel="noopener noreferrer">Ver perfil ↗</a></div>
            </div>
          </div>
          <div class="cv-callout reveal">
            <div>
              <span class="project-label">Perfil profesional</span>
              <h3>¿Quieres conocer mi recorrido?</h3>
              <p>Consulta mi formación, tecnologías y proyecto destacado en una versión preparada para imprimir.</p>
            </div>
            <a class="button primary" href="/cv" target="_blank" rel="noopener noreferrer">Ver currículum ↗</a>
          </div>
          <div class="cv-highlights reveal">
            <article>
              <span class="cv-highlight-label">Experiencia</span>
              <h3>Canguro · 2025</h3>
              <p>6 meses como cuidador de niños.</p>
              <h3>Cal Sardà · 2024</h3>
              <p>5 meses como dependiente.</p>
            </article>
            <article>
              <span class="cv-highlight-label">Certificaciones</span>
              <h3>Inteligencia Artificial</h3>
              <p>Python y Hugging Face Transformers · Cibernarium, 2025.</p>
              <p>Prompting y cartografía de herramientas de IA · Cibernarium, 2025.</p>
            </article>
            <article>
              <span class="cv-highlight-label">Fortalezas</span>
              <h3>Cómo trabajo</h3>
              <p>Trabajo en equipo, empatía, responsabilidad y buena gestión del tiempo.</p>
            </article>
          </div>
        </div>
      </section>

      <section class="section contact" id="contact">
        <div class="container">
          <div class="contact-card reveal">
            <h2>Hagamos algo <em>interesante.</em></h2>
            <p>¿Tienes una idea, una oportunidad o simplemente quieres saludar? Estoy abierto a proyectos, prácticas y conversaciones sobre desarrollo web.</p>
            <div class="actions contact-actions">
              <a class="button primary" href="mailto:salexbarrera@gmail.com">Escríbeme →</a>
              <button type="button" class="button copy-email-btn" data-copy-email="salexbarrera@gmail.com" title="Copiar correo al portapapeles">
                <span class="copy-text">Copiar email</span> <span class="copy-icon">📋</span>
              </button>
              <a class="button" href="https://www.linkedin.com/in/%C3%A0lex-barrera-sard%C3%A0-35b088397/" target="_blank" rel="noopener noreferrer">LinkedIn ↗</a>
            </div>
          </div>
        </div>
      </section>
    </main>

    <footer class="container">
      <span class="footer-name">Àlex Barrera</span>
      <span>Hecho con Astro · Barcelona</span>
    </footer>

    <div class="copy-toast" id="copy-toast" aria-live="polite">
      <span class="copy-toast-check">✓</span>
      <span id="copy-toast-msg">Email copiado al portapapeles</span>
    </div>

