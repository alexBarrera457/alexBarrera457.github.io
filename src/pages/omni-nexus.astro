---
import BaseLayout from '../layouts/BaseLayout.astro';
import LanguageSwitcher from '../components/LanguageSwitcher.astro';

const stack = ['Node.js 24', 'Express 5', 'SQLite (WAL)', 'Astro 5', 'OpenAI SDK', 'Deep Modules', 'Helmet & Security', '27 Tests Unitarios'];

const appViews = [
  {
    id: 'home',
    title: 'Dashboard Principal & Ambient Canvas',
    badge: 'UI & Quick Prompts',
    desc: 'Entorno de chat local con fondo procedural de partículas, panel lateral de inicio rápido (Aprender, Crear, Resolver, Mejorar) e indicador dinámico de runtime.',
    img: '/images/nexus-home.jpg'
  },
  {
    id: 'chat',
    title: 'Sesión de Chat & Memoria Persistente',
    badge: 'Interacción & Diálogo',
    desc: 'Conversación activa sobre arquitectura de Deep Modules con formateo de respuestas, persistencia relacional en SQLite con WAL mode y resaltado en el historial.',
    img: '/images/nexus-chat.jpg'
  },
  {
    id: 'tools',
    title: 'Orquestación & Routing de Herramientas',
    badge: 'Tools: Calculator & Clock',
    desc: 'Plan de ejecución coordinado por OMNI con activación de herramientas de cálculo de expresiones complejas y consulta horaria de sistema sin latencia externa.',
    img: '/images/nexus-tools.jpg'
  }
];
---

<BaseLayout
  title="OMNI // NEXUS · Capa Local de Inteligencia y Chat con IA"
  description="OMNI // NEXUS — Aplicación local de chat inteligente con backend Express, persistencia en SQLite, herramientas modulares (WEB, CALCULATOR, CLOCK) e interfaz en Astro."
  ogImage="https://alexbarrera457.github.io/images/nexus-home.jpg"
  canonicalUrl="https://alexbarrera457.github.io/omni-nexus"
  bodyClass="project-page"
>
  <header class="project-header">
    <div class="container project-header-inner">
      <div class="header-nav-bar">
        <a class="back-link" href="/">← Volver al portfolio</a>
        <LanguageSwitcher />
      </div>

      <div class="header-hero">
        <span class="eyebrow project-eyebrow">Proyecto experimental · Aplicación real · 2026</span>
        <h1 class="project-title">OMNI // NEXUS</h1>
        <p class="lead">
          Capa local de inteligencia y asistente conversacional avanzado diseñado bajo principios de <strong>Deep Modules</strong>.
          Combina un backend modular en <strong>Express 5</strong>, base de datos relacional <strong>SQLite con WAL</strong>,
          routing de herramientas locales (cálculo, reloj, búsqueda web) y una interfaz cinematográfica construida en <strong>Astro 5</strong>.
        </p>
        <div class="stack-list">
          {stack.map((item) => <span class="stack-pill">{item}</span>)}
        </div>
        <div class="header-actions">
          <a class="button primary" href="https://github.com/alexBarrera457" target="_blank" rel="noopener noreferrer" data-header-repo-btn>
            Ver repositorio en GitHub ↗
          </a>
          <a class="button" href="#capturas-reales" data-header-gallery-btn>
            Explorar capturas reales ↓
          </a>
        </div>
      </div>
    </div>
  </header>

  <!-- Real Web Application Hero Showcase -->
  <div class="container cover-wrap" id="capturas-reales">
    <div class="browser-showcase">
      <div class="browser-bar">
        <div class="browser-controls">
          <span class="dot close"></span>
          <span class="dot min"></span>
          <span class="dot max"></span>
        </div>
        <div class="browser-url">
          <span class="url-lock">🔒</span>
          <span class="url-text">http://127.0.0.1:3080/</span>
          <span class="url-badge">Node.js · Express 5 · SQLite WAL</span>
        </div>
        <div class="browser-actions">
          <span class="live-dot"></span>
          <span class="live-text">Captura real de la app</span>
        </div>
      </div>
      <div class="browser-screen">
        <img
          id="main-showcase-img"
          src="/images/nexus-home.jpg"
          alt="Captura real del entorno local OMNI // NEXUS"
          class="showcase-img"
          width="1440"
          height="900"
          fetchpriority="high"
          decoding="async"
        />
        <div class="showcase-floating-badge">
          <span class="floating-icon">✦</span>
          <div>
            <strong>NEXUS Runtime Online</strong>
            <span>Local Intelligence Layer · Provider: gpt-4.1</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <main class="container project-content">
    <!-- Real Views Tabs & Gallery Section -->
    <section class="project-panel gallery-panel">
      <div class="panel-header-row">
        <div>
          <h2 data-gallery-title>Capturas reales de la aplicación</h2>
          <p data-gallery-subtitle>
            Vistas reales de la plataforma capturadas en ejecución local con persistencia SQLite y fondo procedural en canvas:
          </p>
        </div>
      </div>

      <div class="views-grid">
        {appViews.map((view) => (
          <article class="view-card" data-view-id={view.id}>
            <div class="view-image-wrap">
              <span class="view-badge">{view.badge}</span>
              <img src={view.img} alt={view.title} loading="lazy" decoding="async" width="800" height="500" />
            </div>
            <div class="view-info">
              <h4>{view.title}</h4>
              <p>{view.desc}</p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- Key Impact Metrics -->
    <section class="metrics-grid">
      <div class="metric-card">
        <span class="metric-num">27 Tests</span>
        <span class="metric-label" data-metric-1-label>Suite Automatizada</span>
        <p class="metric-desc" data-metric-1-desc>100% tests superados en pruebas unitarias y de integración con supertest y node:test.</p>
      </div>
      <div class="metric-card">
        <span class="metric-num">4 Tools</span>
        <span class="metric-label" data-metric-2-label>Routing de Herramientas</span>
        <p class="metric-desc" data-metric-2-desc>Orquestación inteligente entre CALCULATOR, CLOCK, WEB SEARCH y diálogo CHAT.</p>
      </div>
      <div class="metric-card">
        <span class="metric-num">SQLite WAL</span>
        <span class="metric-label" data-metric-3-label>Persistencia ACID</span>
        <p class="metric-desc" data-metric-3-desc>Write-Ahead Logging para lecturas concurrentes sin bloqueo y borrado en cascada.</p>
      </div>
      <div class="metric-card">
        <span class="metric-num">Local-First</span>
        <span class="metric-label" data-metric-4-label>Privacidad Absoluta</span>
        <p class="metric-desc" data-metric-4-desc>Almacenamiento en disco local sin telemetría de terceros con cabeceras Helmet.</p>
      </div>
    </section>

    <!-- Business Context & Motivation -->
    <section class="project-panel">
      <h2 data-section-1-title>Contexto del proyecto: de la nube a la soberanía de datos local</h2>
      <p data-section-1-intro>
        La mayoría de asistentes de inteligencia artificial dependen íntegramente de servidores remotos cerrados, lo que plantea problemas de privacidad, latencias impredecibles y falta de control sobre el historial personal. OMNI // NEXUS nació para explorar cómo construir una capa de inteligencia local, rápida y soberana:
      </p>
      <div class="status-grid">
        <div class="status-box">
          <h3 data-status-problem-title>⚠️ Limitaciones de clientes IA tradicionales</h3>
          <ul class="bullet-list" data-status-problem-list>
            <li>Tus conversaciones, consultas y código residen en infraestructuras ajenas.</li>
            <li>Incapacidad de ejecutar herramientas locales precisas (reloj del sistema, cálculos matemáticos sin sesgo).</li>
            <li>Interfaces lentas y sobrecargadas con modelos de suscripción mensuales obligatorios.</li>
            <li>Ausencia de una base de datos local inspectable con formato SQL estándar.</li>
          </ul>
        </div>
        <div class="status-box success">
          <h3 data-status-solution-title>💡 Solución implementada en OMNI // NEXUS</h3>
          <ul class="bullet-list" data-status-solution-list>
            <li>Runtime local en Express 5 con seguridad HTTP estricta (Helmet, rate limiting por IP).</li>
            <li>Base de datos SQLite persistente con consultas instantáneas y esquema relacional abierto.</li>
            <li>Sistema de herramientas desacoplado que resuelve operaciones matemáticas y temporales en milisegundos.</li>
            <li>Modo DEMO offline automático para operar incluso sin conexión o sin API keys configuradas.</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- Architecture & Engineering -->
    <section class="project-panel">
      <h2 data-section-2-title>Arquitectura técnica y principios de Deep Modules</h2>
      <p data-section-2-intro>
        El sistema aplica de manera rigurosa la filosofía de <strong>Deep Modules</strong> (John Ousterhout): módulos con interfaces estrechas que ocultan implementaciones ricas y complejas:
      </p>

      <div class="arch-cards-grid">
        <div class="arch-card">
          <div class="arch-header">
            <span class="arch-icon">⚡</span>
            <h4>Backend Express 5 Modular</h4>
          </div>
          <ul class="bullet-list">
            <li><strong>Servidor Desacoplado:</strong> <code>server.js</code> condensado en menos de 90 líneas legibles y testeables.</li>
            <li><strong>Routers Dedicados:</strong> Controladores específicos para <code>/api/chat</code>, <code>/api/conversations</code>, <code>/api/memory</code> y <code>/api/health</code>.</li>
            <li><strong>Seguridad por Defecto:</strong> Protección integral con <code>helmet</code>, límites de payload a 256kb y rate limiter en memoria.</li>
            <li><strong>Inyección de Dependencias:</strong> Repositorios y servicios inyectados como fábricas para permitir mocks limpios en tests.</li>
          </ul>
        </div>

        <div class="arch-card">
          <div class="arch-header">
            <span class="arch-icon">💾</span>
            <h4>Persistencia SQLite & Repositorios</h4>
          </div>
          <ul class="bullet-list">
            <li><strong>better-sqlite3 en WAL Mode:</strong> Write-Ahead Logging para permitir lecturas y escrituras concurrentes sin esperas.</li>
            <li><strong>Esquema Relacional Estricto:</strong> Tablas <code>nexus_conversations</code> y <code>nexus_messages</code> con claves foráneas y <code>ON DELETE CASCADE</code>.</li>
            <li><strong>Repositorios Ocultos:</strong> Métodos limpios (<code>getConversations</code>, <code>createConversation</code>, <code>deleteConversation</code>) sin exponer SQL al exterior.</li>
            <li><strong>Memoria Opcional:</strong> Tabla <code>memories</code> para extracción y persistencia de preferencias de usuario a largo plazo.</li>
          </ul>
        </div>

        <div class="arch-card">
          <div class="arch-header">
            <span class="arch-icon">🧠</span>
            <h4>Nexus Service & Tool Routing</h4>
          </div>
          <ul class="bullet-list">
            <li><strong>Planificación de Herramientas:</strong> Detección automática en dos fases (plan y ejecución) entre CALCULATOR, CLOCK y WEB SEARCH.</li>
            <li><strong>Evaluador Matemático Seguro:</strong> Parser aritmético propio en <code>lib/calculator.js</code> con precedencia de operadores y sin <code>eval()</code>.</li>
            <li><strong>Modo DEMO Resiliente:</strong> Fallback sin fallo que resuelve cálculos y respuestas de demostración cuando el LLM no está accesible.</li>
            <li><strong>Frontend Reactivo en Astro 5:</strong> Canvas procedural con órbitas y partículas estelares, navegación accesible y feedback de estado en vivo.</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- Source Code & Repository -->
    <section class="project-panel">
      <h2 data-section-3-title>Repositorio y ejecución local</h2>
      <p data-section-3-intro>El proyecto cuenta con suite de tests, tooling de calidad (ESLint, Prettier) y puesta en marcha en un único comando:</p>
      <div class="code-terminal">
        <div class="terminal-bar">
          <span class="dot red"></span>
          <span class="dot yellow"></span>
          <span class="dot green"></span>
          <span class="terminal-title">bash · omniroute-test · node v24</span>
        </div>
        <pre><code data-terminal-code># Instalar dependencias
npm install

# Ejecutar suite de pruebas (27 tests unitarios e integración)
npm test

# Iniciar servidor Express y frontend en http://127.0.0.1:3000
npm start

# Verificar salud del runtime y herramientas activas
curl http://127.0.0.1:3000/api/health</code></pre>
      </div>
      <div class="action-buttons-row">
        <a class="button primary" href="https://github.com/alexBarrera457" target="_blank" rel="noopener noreferrer" data-repo-btn>
          Ver repositorio en GitHub ↗
        </a>
        <a class="button" href="/#contact" data-contact-btn>
          Contactar conmigo →
        </a>
      </div>
    </section>

    <!-- Conclusion Panel -->
    <section class="project-panel conclusion-panel">
      <h2 data-section-4-title>Conclusión y balance profesional</h2>
      <p data-section-4-text>
        OMNI // NEXUS demuestra cómo diseñar sistemas Node.js modernos con rigor: descomponer la complejidad en Deep Modules testeables, garantizar persistencia local robusta con SQLite y diseñar interfaces de usuario cinemáticas donde la tecnología se siente ágil, privada y fiable.
      </p>
      <div class="conclusion-actions">
        <a class="button primary" href="/#projects" data-cta-btn>
          Ver otros proyectos del portfolio ↗
        </a>
        <a class="button" href="/" data-footer-back>
          ← Volver al inicio
        </a>
      </div>
    </section>
  </main>

