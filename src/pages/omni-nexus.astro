      display: flex;
      flex-direction: column;
      gap: 3.5rem;
    }

    .project-panel {
      padding: 2.2rem;
      border: 1px solid var(--line);
      border-radius: 16px;
      background: var(--surface);
      box-shadow: 0 10px 30px rgba(19, 34, 56, 0.02);
    }

    .project-panel h2 {
      font: 400 clamp(1.6rem, 2.8vw, 2.2rem) var(--serif);
      color: var(--ink);
      margin: 0 0 0.8rem;
    }

    .project-panel p {
      color: var(--muted);
      line-height: 1.68;
      font-size: 1rem;
      margin: 0;
    }

    /* Views Grid */
    .views-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 1.6rem;
      margin-top: 2rem;
    }

    .view-card {
      border: 1px solid var(--line);
      border-radius: 12px;
      background: #ffffff;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      box-shadow: 0 4px 14px rgba(19, 34, 56, 0.04);
      transition: transform 0.25s ease, box-shadow 0.25s ease;
    }

    .view-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 12px 28px rgba(19, 34, 56, 0.08);
    }

    .view-image-wrap {
      position: relative;
      background: #050813;
      overflow: hidden;
      aspect-ratio: 16 / 10;
    }

    .view-image-wrap img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: top center;
      display: block;
      transition: transform 0.3s ease;
    }

    .view-card:hover .view-image-wrap img {
      transform: scale(1.03);
    }

    .view-badge {
      position: absolute;
      top: 0.75rem;
      left: 0.75rem;
      background: rgba(5, 8, 19, 0.88);
      color: #7ce1ff;
      font: 600 0.65rem var(--mono);
      letter-spacing: 0.04em;
      padding: 0.25rem 0.65rem;
      border-radius: 999px;
      backdrop-filter: blur(4px);
      border: 1px solid rgba(124, 225, 255, 0.25);
      z-index: 2;
    }

    .view-info {
      padding: 1.25rem;
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
      flex: 1;
    }

    .view-info h4 {
      font: 600 1.05rem var(--sans);
      color: var(--ink);
      margin: 0;
    }

    .view-info p {
      font-size: 0.88rem;
      line-height: 1.5;
      color: var(--muted);
      margin: 0;
    }

    /* Metrics Grid */
    .metrics-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
      gap: 1.2rem;
    }

    .metric-card {
      padding: 1.8rem;
      border: 1px solid var(--line);
      border-radius: 14px;
      background: var(--surface);
      display: flex;
      flex-direction: column;
      gap: 0.4rem;
      box-shadow: 0 4px 16px rgba(19, 34, 56, 0.02);
    }

    .metric-num {
      font: 400 clamp(2rem, 3.5vw, 2.6rem) var(--serif);
      color: var(--coral-dark);
      line-height: 1;
    }

    .metric-label {
      font: 600 0.82rem var(--mono);
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--ink);
    }

    .metric-desc {
      font-size: 0.85rem;
      line-height: 1.5;
      color: var(--muted);
      margin: 0;
    }

    /* Status Grid */
    .status-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
      gap: 1.5rem;
      margin-top: 1.8rem;
    }

    .status-box {
      padding: 1.6rem;
      border-radius: 12px;
      background: rgba(239, 68, 68, 0.04);
      border: 1px solid rgba(239, 68, 68, 0.16);
    }

    .status-box.success {
      background: rgba(16, 185, 129, 0.05);
      border-color: rgba(16, 185, 129, 0.2);
    }

    .status-box h3 {
      font: 600 1.05rem var(--sans);
      color: var(--ink);
      margin: 0 0 1rem;
    }

    .bullet-list {
      list-style: none;
      padding: 0;
      margin: 0;
      display: flex;
      flex-direction: column;
      gap: 0.65rem;
    }

    .bullet-list li {
      position: relative;
      padding-left: 1.3rem;
      font-size: 0.92rem;
      line-height: 1.55;
      color: var(--muted);
    }

    .bullet-list li::before {
      content: '•';
      position: absolute;
      left: 0.2rem;
      color: var(--coral);
      font-weight: bold;
    }

    /* Architecture Cards */
    .arch-cards-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(290px, 1fr));
      gap: 1.5rem;
      margin-top: 1.8rem;
    }

    .arch-card {
      padding: 1.6rem;
      border: 1px solid var(--line);
      border-radius: 12px;
      background: #ffffff;
      box-shadow: 0 4px 14px rgba(19, 34, 56, 0.03);
    }

    .arch-header {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      margin-bottom: 1rem;
    }

    .arch-icon {
      font-size: 1.3rem;
    }

    .arch-header h4 {
      font: 600 1.05rem var(--sans);
      color: var(--ink);
      margin: 0;
    }

    /* Code Terminal */
    .code-terminal {
      margin-top: 1.4rem;
      border-radius: 12px;
      overflow: hidden;
      background: #111827;
      border: 1px solid #1f2937;
      box-shadow: 0 12px 28px rgba(0, 0, 0, 0.2);
    }

    .terminal-bar {
      display: flex;
      align-items: center;
      gap: 0.45rem;
      padding: 0.7rem 1.1rem;
      background: #1f2937;
      border-bottom: 1px solid #374151;
    }

    .terminal-bar .dot {
      width: 10px;
      height: 10px;
      border-radius: 50%;
    }

    .terminal-bar .dot.red { background: #ef4444; }
    .terminal-bar .dot.yellow { background: #f59e0b; }
    .terminal-bar .dot.green { background: #10b981; }

    .terminal-title {
      font: 500 0.72rem var(--mono);
      color: #9ca3af;
      margin-left: 0.5rem;
    }

    .code-terminal pre {
      margin: 0;
      padding: 1.25rem 1.4rem;
      overflow-x: auto;
    }

    .code-terminal code {
      font: 400 0.85rem/1.65 var(--mono);
      color: #e5e7eb;
    }

    .action-buttons-row {
      display: flex;
      flex-wrap: wrap;
      gap: 1rem;
      align-items: center;
      margin-top: 1.8rem;
    }

    /* Conclusion Panel */
    .conclusion-panel {
      background: linear-gradient(135deg, rgba(52, 120, 246, 0.05), rgba(143, 211, 182, 0.08)), var(--surface);
      border-color: rgba(52, 120, 246, 0.2);
    }

    .conclusion-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 1rem;
      align-items: center;
      margin-top: 1.8rem;
    }

    @media (max-width: 768px) {
      .project-header {
        padding: 5rem 0 2rem;
      }

      .browser-bar {
        flex-wrap: wrap;
      }

      .browser-url {
        order: 3;
        width: 100%;
        max-width: 100%;
      }

      .project-panel {
        padding: 1.5rem;
      }

      .status-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>
</BaseLayout>
